---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AvailabilityBanner from '../../components/AvailabilityBanner.astro';
import { minRentYen, maxRentYen, commonFeeYen, totalMin, totalMax } from '../../data/pricing.mjs';

// 英語ページは和文の波ダッシュではなくenダッシュで表記する（英語SERPでの見え方のため）。
// 数値そのものは rooms.json 由来なので、家賃改定時もここを触る必要はない。
const yen = (n) => '¥' + Number(n).toLocaleString('en-US');
const rentRange = `${minRentYen}–${maxRentYen}`;
const totalRange = `${yen(totalMin)}–${yen(totalMax)}`;
import { img } from '../../data/site-images.mjs';

// 日本語トップと同じく、幅違いWebPがあればそれを配信する（無ければ元のJPEG）。
const hero = img('/images/hero.jpg');
const insta = [1, 2, 3].map((n) => img(`/images/insta-${n}.jpg`));

// 英語圏の検索意図（gaijin house / apartment in kobe / no guarantor / cost）に答えるFAQ。
// ここに書いた内容をそのまま FAQPage 構造化データにも出力する（単一データソース）。
const faqs = [
  {
    q: 'Is this a "gaijin house"?',
    a: 'It is an international share house. In Japan the words "gaijin house", "guest house" and "share house" are often used for the same kind of place. Residents here are a mix of people from Kobe, from elsewhere in Japan, and from other countries — it is not a foreigners-only building.',
  },
  {
    q: 'How much does it cost per month?',
    a: `Rent is ${rentRange} depending on the room, plus a flat common fee of ${commonFeeYen} per month — ${totalRange} in total. The common fee covers electricity, gas, water, internet and shared consumables, so there are no separate utility contracts to sign or bills to pay.`,
  },
  {
    q: 'What do I pay to move in?',
    a: 'A flat ¥50,000, plus prorated rent for your first month. The ¥50,000 breaks down into ¥25,000 for contract and cleaning and ¥25,000 as a refundable deposit, returned in full when you leave if there is no damage. There is no key money (reikin) and no agency fee.',
  },
  {
    q: 'Do I need a Japanese guarantor?',
    a: 'In principle, no. A guarantor is not required. For the contract you will need a valid ID, a personal seal (hanko), and an emergency contact phone number. The contract is a fixed-term tenancy agreement.',
  },
  {
    q: 'Is the room furnished?',
    a: 'Yes. Each room comes with a bed, futon and sheets, a desk, a chair and an air conditioner, so you can move in with just your personal belongings. The shared kitchen and living areas are fully equipped, so personal fridges, cooking appliances and heaters are not needed in the rooms.',
  },
  {
    q: 'How long do I have to stay?',
    a: 'We generally expect residents to stay six months or longer. Shorter stays can be discussed and may carry a surcharge. To move out, please give at least one month of notice.',
  },
  {
    q: 'Can I apply from outside Japan?',
    a: 'Please get in touch through the contact form and tell us your planned arrival date. Our policy is to meet in person and show you the house before we both decide, so a viewing is part of the process — we will work out the timing with you.',
  },
  {
    q: 'Where exactly is the house?',
    a: 'Nada Ward, Kobe, inside the covered Suidosuji shopping arcade. It is a 7-minute walk from JR Maya Station or Hankyu Ojikoen Station, and two stops from Sannomiya, the centre of Kobe. Kobe University and Osaka are both an easy commute.',
  },
];

const pageTitle = `Share House in Kobe — from ${minRentYen}/mo, No Key Money | The Headquarters Kobe`;
const pageDesc = `Rooms ${rentRange} plus ${commonFeeYen} all-in common fee. Move in for ¥50,000 — no key money, no agency fee, no guarantor. Furnished international share house in Nada, Kobe. Viewings open.`;

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const lodgingLd = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: 'The Headquarters Kobe',
  alternateName: ['The Headquarters Kobe Share House', 'シェアハウスThe Headquarters KOBE'],
  description: `An international share house in Nada Ward, Kobe, inside the Suidosuji shopping arcade. 10 furnished rooms, ${rentRange} per month plus a ${commonFeeYen} all-inclusive common fee. No key money, no agency fee, guarantor not required in principle.`,
  url: 'https://theheadquarters.jp/en/',
  image: 'https://theheadquarters.jp/images/hero.jpg',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Nada Ward, Kobe',
    addressRegion: 'Hyogo',
    addressCountry: 'JP',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 34.7125986, longitude: 135.2235467 },
  priceRange: `${minRentYen}–${maxRentYen} per month (plus ${commonFeeYen} common fee)`,
  numberOfRooms: 10,
  petsAllowed: false,
  sameAs: ['https://www.instagram.com/theheadquarters.kobe/'],
};
---

<html lang="en">
  <head>
    <BaseHead title={pageTitle} description={pageDesc} />
    <script type="application/ld+json" set:html={JSON.stringify(lodgingLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    {hero.webpSrcset && (
      <link
        rel="preload"
        as="image"
        imagesrcset={hero.webpSrcset}
        imagesizes="100vw"
        fetchpriority="high"
      />
    )}
  </head>

  <body>
    <Header />

    <main style="width: auto; max-width: 1080px; margin: 0 auto; padding: 24px;">

      <section class="hero heroOverlay">
        <picture>
          {hero.webpSrcset && <source type="image/webp" srcset={hero.webpSrcset} sizes="100vw" />}
          <img
            src={hero.src}
            alt="The Headquarters Kobe share house in the Suidosuji arcade, Nada Ward, Kobe"
            class="heroImage"
            width={hero.width}
            height={hero.height}
            fetchpriority="high"
            decoding="async"
          />
        </picture>
        <div class="heroText">
          <p class="kicker">THE HEADQUARTERS KOBE</p>
          <h1>A share house in Kobe, for people from anywhere.</h1>
          <p class="lead">Furnished rooms in the heart of the Suidosuji arcade, Nada Ward — 7 minutes on foot from JR Maya or Hankyu Ojikoen, two stops from Sannomiya.</p>
          <p class="heroPrice">{rentRange}/month + {commonFeeYen} all-in common fee · Move in for ¥50,000 · No key money, no agency fee, no guarantor</p>
          <div class="heroActions">
            <a class="btnPrimary" href="/en/contact">Inquire / Book a Viewing</a>
          </div>
        </div>
      </section>

      <AvailabilityBanner lang="en" />

      <section class="section">
        <h2 class="sectionTitle">What it costs to live here</h2>
        <div class="card prose">
          <p>
            Everything below is the full price. There is no key money (<em>reikin</em>), no agency fee, and no guarantor company fee —
            the three charges that usually make renting an apartment in Kobe expensive to start.
          </p>
          <div class="tableWrap">
            <table class="costTable">
              <tbody>
                <tr><th>Rent</th><td>{rentRange} / month, depending on the room</td></tr>
                <tr><th>Common fee</th><td>{commonFeeYen} / month — electricity, gas, water, internet and shared consumables included</td></tr>
                <tr><th><strong>Total each month</strong></th><td><strong>{totalRange}</strong></td></tr>
                <tr><th>To move in</th><td>¥50,000 flat (¥25,000 contract &amp; cleaning + ¥25,000 refundable deposit), plus prorated first-month rent</td></tr>
                <tr><th>Key money</th><td>¥0</td></tr>
                <tr><th>Agency fee</th><td>¥0</td></tr>
                <tr><th>Guarantor</th><td>Not required, in principle</td></tr>
                <tr><th>Furniture &amp; appliances</th><td>¥0 — bed, futon and sheets, desk, chair and air conditioner are already in the room</td></tr>
              </tbody>
            </table>
          </div>
          <p class="muted">Common fees may vary depending on circumstances. Rooms: 10 in total, across floors 3–5 of the building, plus a rooftop.</p>
          <a class="aboutLink" href="/en/rooms">See rooms and current vacancies →</a>
        </div>
      </section>

      <section class="section">
        <h2 class="sectionTitle">Renting an apartment in Kobe vs. living here</h2>
        <div class="card prose">
          <p>
            If you are comparing this with a regular rental apartment in Kobe, the monthly rent is only part of the picture.
            A standard Japanese lease commonly asks for key money, a deposit, an agency fee and a guarantor company fee before you get the key,
            and you still have to buy furniture and set up utility contracts yourself.
          </p>
          <div class="tableWrap">
            <table class="costTable">
              <thead>
                <tr><th></th><th>Typical apartment in Kobe</th><th>The Headquarters Kobe</th></tr>
              </thead>
              <tbody>
                <tr><th>Upfront cost</th><td>Commonly several months of rent (key money, deposit, agency fee, guarantor fee)</td><td>¥50,000 flat, half of it refundable</td></tr>
                <tr><th>Guarantor</th><td>Usually required, or a paid guarantor company</td><td>Not required, in principle</td></tr>
                <tr><th>Furniture</th><td>Buy it yourself</td><td>Already in the room</td></tr>
                <tr><th>Utilities</th><td>Separate contracts and monthly bills</td><td>Included in the common fee</td></tr>
                <tr><th>Internet</th><td>Contract and installation</td><td>Already connected</td></tr>
                <tr><th>Minimum term</th><td>Usually two years</td><td>Six months as a guide</td></tr>
                <tr><th>Neighbours</th><td>Strangers behind a door</td><td>A shared kitchen, living room and rooftop</td></tr>
              </tbody>
            </table>
          </div>
          <p>
            The trade-off is honest: you get a private room, not a private home. Kitchen, bathroom, living room and rooftop are shared.
            If that suits you, it is the cheapest realistic way to start living in central Kobe.
          </p>
        </div>
      </section>

      <section class="section">
        <h2 class="sectionTitle">Moving here from overseas</h2>
        <div class="card prose">
          <p>
            A good share of the people who have lived here came from outside Japan — students, working-holiday travellers and people starting a job in Kansai.
            The practical questions usually come down to these.
          </p>
          <ul>
            <li><strong>No guarantor.</strong> In principle you do not need a Japanese guarantor or a guarantor company. You will need a valid ID, a personal seal (<em>hanko</em>) and an emergency contact number.</li>
            <li><strong>Nothing to buy.</strong> The room is furnished and the common fee covers utilities and internet, so there are no contracts to arrange in Japanese before you can live normally.</li>
            <li><strong>English is fine.</strong> Send your enquiry in English through the contact form — we will reply in English.</li>
            <li><strong>A viewing is part of the process.</strong> We show you the house, sit down in the living room and talk before either side decides. If you are still abroad, tell us your arrival date and we will plan around it.</li>
            <li><strong>Getting around.</strong> Sannomiya is two stops away, Kobe University is a short commute, and Osaka is comfortably in range for work or study.</li>
          </ul>
          <a class="aboutLink" href="/en/procedures">Full move-in process and FAQ →</a>
        </div>
      </section>

      <section class="section">
        <h2 class="sectionTitle">The neighbourhood</h2>
        <div class="card prose">
          <p>
            The house sits on the main street of the Suidosuji shopping arcade, under the covered roof, next door to the local police box (<em>koban</em>) —
            which makes it easy to find on any map app. This is a working local shopping street, not a tourist one: cheap vegetables, a fishmonger, a public bathhouse.
          </p>
          <ul class="factList">
            <li><span>Greengrocer</span> right in front of the building</li>
            <li><span>Convenience store</span> 30 seconds</li>
            <li><span>Supermarket</span> 2 minutes</li>
            <li><span>100-yen shop</span> 2 minutes</li>
            <li><span>Ojikoen park</span> 8 minutes</li>
            <li><span>JR Maya / Hankyu Ojikoen</span> 7 minutes on foot</li>
            <li><span>Sannomiya</span> two stops by train</li>
          </ul>
          <a class="aboutLink" href="/en/location">Access and area guide →</a>
        </div>
      </section>

      <section class="section">
        <h2 class="sectionTitle">About The Headquarters Kobe</h2>
        <div class="card prose">
          <p>
            The Headquarters Kobe is a share house near Ojikoen Station in Nada Ward, Kobe — right in the middle of the lively Suidosuji shopping arcade.
            Open-minded residents from the neighbourhood, across Japan, and around the world live together here, sharing inspiration and everyday life.
          </p>
          <p>
            Every morning starts with a "good morning," and every evening someone greets you home. Cook together, host parties, read on the rooftop, or fire up the BBQ in summer.
            What you share here isn't just a house — it's life itself.
          </p>
          <div class="aboutStats">
            <div><span class="statNum">10</span><span class="statLabel"> rooms</span></div>
            <div><span class="statNum">5F</span><span class="statLabel"> building (3F–5F + rooftop)</span></div>
            <div><span class="statNum">~280</span><span class="statLabel"> m²</span></div>
          </div>
          <a class="aboutLink" href="/en/hq-kobe">Learn more →</a>
        </div>
      </section>

      <section class="section">
        <h2 class="sectionTitle">Frequently asked questions</h2>
        <div class="card prose faqList">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="section">
        <h2 class="sectionTitle">Instagram</h2>
        <p class="muted">See life at the house</p>
        <div class="instaGrid">
          {insta.map((im, i) => (
            <picture>
              {im.webpSrcset && (
                <source
                  type="image/webp"
                  srcset={im.webpSrcset}
                  sizes="(max-width: 600px) 32vw, 336px"
                />
              )}
              <img
                src={im.src}
                alt={`Life at The Headquarters Kobe share house ${i + 1}`}
                width={im.width}
                height={im.height}
                loading="lazy"
                decoding="async"
              />
            </picture>
          ))}
        </div>
        <p style="margin-top:16px;">
          <a class="btnGhost" href="https://www.instagram.com/theheadquarters.kobe/" target="_blank" rel="noopener">
            View on Instagram →
          </a>
        </p>
      </section>

      <section class="section">
        <h2 class="sectionTitle">About the House</h2>
        <div class="infoGrid">
          <a class="infoCard" href="/en/hq-kobe">
            <div class="infoKicker">ABOUT</div>
            <div class="infoTitle">About the House</div>
            <div class="infoDesc">Concept, atmosphere, and residents of The Headquarters Kobe.</div>
          </a>
          <a class="infoCard" href="/en/facilities">
            <div class="infoKicker">FACILITIES</div>
            <div class="infoTitle">Common Areas</div>
            <div class="infoDesc">Kitchen, bath, rooftop, and all shared spaces.</div>
          </a>
          <a class="infoCard" href="/en/rooms">
            <div class="infoKicker">ROOMS</div>
            <div class="infoTitle">Room Guide</div>
            <div class="infoDesc">Vacancies, photos, and rent for each room — from {minRentYen}/month.</div>
          </a>
          <a class="infoCard" href="/en/location">
            <div class="infoKicker">ACCESS</div>
            <div class="infoTitle">Access &amp; Area</div>
            <div class="infoDesc">A short walk from Ojikoen Station, right next to Suidosuji arcade.</div>
          </a>
          <a class="infoCard" href="/en/procedures">
            <div class="infoKicker">HOW TO</div>
            <div class="infoTitle">Move-in Process &amp; FAQ</div>
            <div class="infoDesc">From viewing to move-in day, plus frequently asked questions.</div>
          </a>
          <a class="infoCard" href="/en/contact">
            <div class="infoKicker">CONTACT</div>
            <div class="infoTitle">Contact Us</div>
            <div class="infoDesc">Viewings, vacancy checks, and any other inquiries welcome.</div>
          </a>
        </div>
      </section>

    </main>
    <Footer />
  </body>
</html>

<style>
  .hero { padding: 48px 24px 24px; text-align: center; }
  .kicker { margin: 0 0 12px; letter-spacing: .12em; text-transform: uppercase; font-size: 12px; color: rgb(var(--gray)); }
  .hero h1 { margin: 0 0 16px; font-size: clamp(28px, 4vw, 48px); letter-spacing: -0.02em; line-height: 1.2; }
  .lead { margin: 0 auto 24px; max-width: 56ch; font-size: 18px; color: rgb(var(--gray)); }
  .heroPrice { margin: -8px auto 20px; font-size: 15px; font-weight: 600; color: rgba(255,255,255,.95); text-shadow: 0 2px 12px rgba(0,0,0,.4); }
  .heroActions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btnPrimary, .btnGhost { display: inline-block; padding: 12px 16px; border-radius: 12px; text-decoration: none; font-weight: 700; }
  .btnPrimary { background: var(--accent); color: white; }
  .btnGhost { border: 1px solid rgba(var(--gray), 35%); color: rgb(var(--gray-dark)); background: rgba(255,255,255,.7); }
  .heroImage { display: block; width: 100%; max-width: 1080px; height: clamp(260px, 46vw, 520px); object-fit: cover; border-radius: 20px; margin: 28px auto 0; box-shadow: 0 18px 60px rgba(0,0,0,.12); }
  .heroOverlay { position: relative; padding: 0; }
  .heroOverlay .heroImage { height: clamp(320px, 52vw, 560px); border-radius: 24px; margin: 0 auto; filter: brightness(0.82); }
  .heroOverlay .heroText { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 24px; text-align: center; color: white; }
  .heroOverlay .kicker { color: rgba(255,255,255,.8); }
  .heroOverlay h1 { color: white; text-shadow: 0 6px 24px rgba(0,0,0,.35); }
  .heroOverlay .lead { color: rgba(255,255,255,.9); }
  .section { padding: 32px; background: linear-gradient(180deg, rgba(var(--gray-light), 0.6), rgba(var(--gray-light), 0.2)); border-radius: 24px; margin-top: 32px; }
  .sectionTitle { margin: 0 0 16px; font-size: 22px; }
  .card { background: white; border-radius: 16px; padding: 20px; box-shadow: var(--box-shadow); }
  .muted { color: rgb(var(--gray)); font-size: 14px; }
  .instaGrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 16px; }
  .instaGrid img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 12px; }
  .infoGrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 16px; }
  .infoCard { display: block; padding: 22px 20px; border-radius: 16px; background: white; box-shadow: var(--box-shadow); text-decoration: none; color: inherit; transition: transform .15s ease, box-shadow .15s ease; }
  .infoCard:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(0,0,0,.12); }
  .infoKicker { font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin-bottom: 6px; }
  .infoTitle { font-size: 16px; font-weight: 700; margin-bottom: 6px; color: rgb(var(--gray-dark)); }
  .infoDesc { font-size: 13px; color: rgb(var(--gray)); line-height: 1.5; }
  .aboutStats { display: flex; gap: 32px; margin: 20px 0 16px; padding: 20px 0; border-top: 1px solid #eee; border-bottom: 1px solid #eee; }
  .statNum { font-size: 1.8rem; font-weight: 700; color: #1a1a2e; }
  .statLabel { font-size: 0.85rem; color: #666; }
  .aboutLink { display: inline-block; margin-top: 12px; font-size: 0.9rem; font-weight: 600; color: #3355cc; text-decoration: none; }
  .aboutLink:hover { text-decoration: underline; }

@media (max-width: 600px) {
  .heroOverlay .heroImage {
    aspect-ratio: auto;
    min-height: 380px;
  }
  .heroOverlay h1 { font-size: 1.5em; }
}
</style>

<style>
  .tableWrap { overflow-x: auto; margin: 16px 0; }
  .costTable { width: 100%; border-collapse: collapse; font-size: 15px; }
  .costTable th, .costTable td { text-align: left; padding: 10px 12px; border-bottom: 1px solid #eee; vertical-align: top; }
  .costTable thead th { font-size: 13px; color: rgb(var(--gray)); border-bottom: 2px solid #e5e5e5; }
  .costTable tbody th { width: 30%; font-weight: 600; color: rgb(var(--gray-dark)); white-space: nowrap; }
  .prose ul { padding-left: 1.2em; line-height: 1.7; }
  .prose li { margin-bottom: 8px; }
  .factList { list-style: none; padding-left: 0; }
  .factList li { display: flex; gap: 10px; border-bottom: 1px solid #f0f0f0; padding: 8px 0; margin: 0; }
  .factList span { min-width: 210px; font-weight: 600; color: rgb(var(--gray-dark)); }
  .faqList details { border-bottom: 1px solid #eee; padding: 12px 0; }
  .faqList details:last-child { border-bottom: none; }
  .faqList summary { cursor: pointer; font-weight: 600; color: rgb(var(--gray-dark)); }
  .faqList details p { margin: 10px 0 0; line-height: 1.7; color: rgb(var(--gray-dark)); }
  @media (max-width: 600px) {
    .costTable tbody th { width: auto; white-space: normal; }
    .factList li { flex-direction: column; gap: 2px; }
    .factList span { min-width: 0; }
  }
</style>
