---
import { getCollection } from 'astro:content';
import AvailabilityBanner from '../components/AvailabilityBanner.astro';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { minRentYen, maxRentYen, rentRange, commonFeeYen, roomCount } from '../data/pricing.mjs';
import thumbs from '../data/thumbs.json';
import { img } from '../data/site-images.mjs';

// 固定画像（hero / Instagram）は幅違いWebPが用意されていればそれを配信する。
// 未生成のときは元のJPEGにフォールバックするので表示は変わらない。
const hero = img('/images/hero.jpg');
const insta = [1, 2, 3].map((n) => img(`/images/insta-${n}.jpg`));

// モバイル(<=600px)専用のヒーローモザイク。
// /images/hero.jpg は 1189x438 の超横長パノラマで、390px幅・高さ380pxの枠では
// 中央のごく一部（人物2人）しか見えず、ハウスの賑わいも建物も伝わらなかった。
// そこで「賑わい1枚＋屋上・個室の2枚」に組み替える。PC(>600px)はパノラマのまま。
const heroMob = {
  // リビングでの鍋パーティー。10人前後の住人の顔と食卓が1枚に入る＝賑わいの証拠。
  // 屋上BBQの写真も候補だったが、16:10に切るとグリルが画面の半分を占めて
  // 「人が集まっている家」に見えなかったため不採用。
  crowd: img('/wp-content/uploads/2019/11/なべ-1-1024x768.jpg'),
  // 屋上テラス（昼）。デッキ・家具・六甲の山並みが入り、小さいタイルでも一目で「屋上」と分かる
  roof: img('/wp-content/uploads/2019/08/HQbbq6-1-1024x682.jpg'),
  // 個室301（家賃レンジの下限の部屋）。「全10室個室」バッジの裏づけになる
  room: img('/wp-content/uploads/2021/09/301-1024x683.jpg'),
};

// ブログカードは原寸ではなく一覧用サムネイル（500px）を使う。
// 原寸のままだと1枚あたり400KB超がトップページに乗り、LCPを直撃する。
const thumbMap = thumbs;
function thumbOf(u) {
  return thumbMap[u] ?? { src: undefined, w: undefined, h: undefined };
}

// 全記事取得
const entries = await getCollection('blog');

// 固定ページ（kind: page）
const pages = entries
  .filter((e) => e.data.kind === 'page')
  .sort((a, b) =>
    (a.slug ?? a.id ?? '').localeCompare(b.slug ?? b.id ?? '', 'ja')
  );

// トップ用ページ（overview優先）
const home =
  pages.find((e) => (e.id ?? '').toLowerCase() === 'bulk/overview') ??
  pages.find((e) => (e.slug ?? '').toLowerCase() === 'bulk/overview') ??
  pages[0];

if (!home) throw new Error('No page entries found (kind: page).');

// Astro v5: rendered.html を使用
const html = home.rendered?.html ?? '';
if (!html) throw new Error('Home page has no rendered.html.');

// 最新ブログ（kind: post）
const latestPosts = entries
  .filter((e) => e.data.kind === 'post')
  .sort((a, b) => b.data.pubDate - a.data.pubDate)
  .slice(0, 3)
  .map((post) => {
    const match = post.body?.match(/!\[.*?\]\(((?:https?:\/\/|\/)[^)]+)\)/);
    const desc = post.data.description.replace(/&#(\d+);/g, (_, code) => String.fromCharCode(Number(code))).replace(/&amp;/g, '&').replace(/&quot;/g, '"');
    return { ...post, firstImage: match ? match[1] : (post.data.coverImage ?? null), desc };
  });
---

<html lang="ja">
  <head>
    <BaseHead
      title="The Headquarters Kobe｜神戸・王子公園のシェアハウス（水道筋商店街）"
      description={`神戸市灘区・水道筋商店街の中心にあるシェアハウス。王子公園駅・JR摩耶駅から徒歩7分、三宮まで約10分、神戸大学にも好アクセス。家賃${minRentYen}〜、礼金・仲介手数料なし、保証人原則不要。内見受付中。`}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'LodgingBusiness',
        name: 'The Headquarters Kobe',
        alternateName: 'シェアハウスThe Headquarters KOBE',
        description:
          `神戸市灘区・水道筋商店街の中心にあるシェアハウス。王子公園駅・JR摩耶駅から徒歩7分。全10室、家賃${rentRange}。`,
        url: 'https://theheadquarters.jp/',
        image: 'https://theheadquarters.jp/images/hero.jpg',
        address: {
          '@type': 'PostalAddress',
          addressLocality: '神戸市灘区',
          addressRegion: '兵庫県',
          addressCountry: 'JP',
        },
        geo: {
          '@type': 'GeoCoordinates',
          latitude: 34.7125986,
          longitude: 135.2235467,
        },
        priceRange: `${minRentYen}〜${maxRentYen}/月（共益費${commonFeeYen}別）`,
        sameAs: [
          'https://www.instagram.com/theheadquarters.kobe/',
        ],
      })}
    />
    {/* LCP画像はビューポートで変わる。PCはパノラマ、モバイルはモザイクの大タイル。
        media を付けないと両方ダウンロードしてしまうので必ず出し分ける。 */}
    {hero.webpSrcset && (
      <link
        rel="preload"
        as="image"
        media="(min-width: 601px)"
        imagesrcset={hero.webpSrcset}
        imagesizes="100vw"
        fetchpriority="high"
      />
    )}
    {heroMob.crowd.webpSrcset && (
      <link
        rel="preload"
        as="image"
        media="(max-width: 600px)"
        imagesrcset={heroMob.crowd.webpSrcset}
        imagesizes="100vw"
        fetchpriority="high"
      />
    )}
  </head>

  <body>
    <Header />

    <!-- Hero（全幅）
         PC(>600px): パノラマ1枚＋テキスト重ね（従来どおり）
         モバイル(<=600px): コピー帯 → 写真モザイク3枚 → 実データバッジ に組み替える。
         並べ替えは .heroOverlay を flex-column にして order で行う（DOM順は据え置き）。 -->
    <section class="hero heroOverlay">
      <div class="heroMedia">
        <picture>
          {/* モバイルは同じ <img> の中身だけ賑わい写真に差し替える（二重ダウンロードを避ける） */}
          {heroMob.crowd.webpSrcset && (
            <source media="(max-width: 600px)" type="image/webp" srcset={heroMob.crowd.webpSrcset} sizes="100vw" />
          )}
          <source media="(max-width: 600px)" srcset={heroMob.crowd.src} />
          {hero.webpSrcset && <source type="image/webp" srcset={hero.webpSrcset} sizes="100vw" />}
          <img
            src={hero.src}
            alt="The Headquarters Kobe の暮らし"
            class="heroImage"
            width={hero.width}
            height={hero.height}
            fetchpriority="high"
            decoding="async"
          />
        </picture>
        {/* 以下2枚はモバイル専用。PCでは display:none なので loading="lazy" と合わせて
            ビューポートに入らず＝ダウンロードも発生しない。 */}
        <picture>
          {heroMob.roof.webpSrcset && (
            <source type="image/webp" srcset={heroMob.roof.webpSrcset} sizes="50vw" />
          )}
          <img
            src={heroMob.roof.src}
            alt="屋上テラス（神戸の山と街を望む）"
            class="heroTile"
            width={heroMob.roof.width}
            height={heroMob.roof.height}
            loading="lazy"
            decoding="async"
          />
        </picture>
        <picture>
          {heroMob.room.webpSrcset && (
            <source type="image/webp" srcset={heroMob.room.webpSrcset} sizes="50vw" />
          )}
          <img
            src={heroMob.room.src}
            alt="個室（家具・家電つき）"
            class="heroTile"
            width={heroMob.room.width}
            height={heroMob.room.height}
            loading="lazy"
            decoding="async"
          />
        </picture>
      </div>
      <div class="heroText">
        <p class="kicker">THE HEADQUARTERS KOBE</p>
        <h1>ここで過ごした日々が、一生の宝になる。</h1>
        <p class="lead">神戸・水道筋のシェアハウス。集まって、笑って、共に育つ場所。</p>
        <div class="heroActions">
          <a class="btnPrimary" href="/contact">内見・お問い合わせ</a>
        </div>
      </div>
      {/* モバイル専用の実データ帯。数値は rooms.json（pricing.mjs）が単一データソース */}
      <ul class="heroFacts">
        <li><b>家賃 {minRentYen}〜</b><span>＋共益費{commonFeeYen}</span></li>
        <li><b>全{roomCount}室 個室</b><span>家具・家電つき</span></li>
        <li><b>駅 徒歩7分</b><span>王子公園／JR摩耶</span></li>
      </ul>
    </section>

    <div style="padding: 0 24px;">
      <AvailabilityBanner lang="ja" />
    </div>

    <main style="width: auto; max-width: 1080px; margin: 0 auto; padding: 24px;">

      <!-- Overview -->
      <section class="section">
        <h2 class="sectionTitle">The Headquarters Kobe について</h2>
        <p>
          神戸市灘区・王子公園駅近く、活気ある水道筋商店街のど真ん中にあるシェアハウスです。
          地元から日本から世界から集まるオープンマインドな住人たちが、共に暮らし、刺激しあい、楽しい生活をシェアしています。
        </p>
        <p>
          三ノ宮まで約10分、神戸大学にも近く、大阪方面へのアクセスも抜群。
          商店街では安くて新鮮な食材がすぐ手に入り、近くには温泉が湧く銭湯も。
        </p>
        <p>
          朝の「おはよう」から夜の「ただいま」まで、誰かがいる。一緒にご飯を作ったり、屋上でバーベキューやプールを楽しんだり。
          シェアするのは単なる住まいではなく、日々の<em>life</em>です。
        </p>
        <div class="aboutStats">
          <div><span class="statNum">10</span><span class="statLabel">室</span></div>
          <div><span class="statNum">5F</span><span class="statLabel">建て（3〜5F＋屋上）</span></div>
          <div><span class="statNum">約280</span><span class="statLabel">㎡</span></div>
        </div>
        <a class="aboutLink" href="/blog/hq-kobe">詳しく見る →</a>
      </section>
<section class="section">
  <h2 class="sectionTitle">住まいについて</h2>
  <div class="infoGrid">
    <a class="infoCard" href="/blog/hq-kobe">
      <div class="infoKicker">ABOUT</div>
      <div class="infoTitle">ハウスについて</div>
      <div class="infoDesc">The Headquarters Kobeの概要・雰囲気・住人について。</div>
    </a>
    <a class="infoCard" href="/facilities">
      <div class="infoKicker">FACILITIES</div>
      <div class="infoTitle">共用部の紹介</div>
      <div class="infoDesc">キッチン・バス・屋上など共用スペースの紹介。</div>
    </a>
    <a class="infoCard" href="/rooms">
      <div class="infoKicker">ROOMS</div>
      <div class="infoTitle">お部屋紹介</div>
      <div class="infoDesc">空室状況・料金・各部屋の雰囲気をチェック。</div>
    </a>
    <a class="infoCard" href="/location">
      <div class="infoKicker">ACCESS</div>
      <div class="infoTitle">アクセスと周辺情報</div>
      <div class="infoDesc">王子公園駅から徒歩圏内。水道筋商店街のすぐそば。</div>
    </a>
    <a class="infoCard" href="/procedures">
      <div class="infoKicker">HOW TO</div>
      <div class="infoTitle">入居の流れとQ&A</div>
      <div class="infoDesc">内見から契約まで。よくある質問もまとめています。</div>
    </a>
    <a class="infoCard" href="/contact">
      <div class="infoKicker">CONTACT</div>
      <div class="infoTitle">お問い合わせ</div>
      <div class="infoDesc">内見・空室確認・その他のご相談はこちらから。</div>
    </a>
  </div>
</section>

      <!-- 最新ブログ -->
      <section class="section">
        <h2 class="sectionTitle">最新ブログ</h2>
        <div class="grid">
          {latestPosts.map((post) => (
            <a class="card linkCard" href={`/blog/${post.id}/`}>
              {post.firstImage && (
                <img
                  src={thumbOf(post.firstImage).src ?? post.firstImage}
                  width={thumbOf(post.firstImage).w}
                  height={thumbOf(post.firstImage).h}
                  loading="lazy"
                  decoding="async"
                  alt={post.data.title}
                  class="cardThumb"
                />
              )}
              <div class="cardBody">
                {post.data.categories.length > 0 && (
                  <div class="cardCats">
                    {post.data.categories.map((cat) => <span class="catBadge" data-cat={cat}>{cat}</span>)}
                  </div>
                )}
                <h3>{post.data.title}</h3>
                <p>{post.desc}</p>
              </div>
            </a>
          ))}
        </div>
        <p style="margin-top:16px;">
          <a class="btnGhost" href="/blog">ブログをもっと見る →</a>
        </p>
      </section>

<section class="section">
  <h2 class="sectionTitle">Instagram</h2>
  <p class="muted">暮らしの様子はこちら</p>

  <div class="instaGrid">
    {insta.map((im, i) => (
      <picture>
        {im.webpSrcset && (
          <source
            type="image/webp"
            srcset={im.webpSrcset}
            sizes="(max-width: 600px) 32vw, 336px"
          />
        )}
        <img
          src={im.src}
          alt={`Instagram photo ${i + 1}`}
          width={im.width}
          height={im.height}
          loading="lazy"
          decoding="async"
        />
      </picture>
    ))}
  </div>

  <p style="margin-top:16px;">
    <a class="btnGhost"
       href="https://www.instagram.com/theheadquarters.kobe/"
       target="_blank"
       rel="noopener">
      Instagramで見る →
    </a>
  </p>
</section>

    </main>
    <Footer />

    <!-- モバイル用の追従CTA -->
    <div class="stickyCta">
      <a class="stickyCtaBtn" href="/contact">内見を申し込む（無料）</a>
    </div>
  </body>
</html>

<style>
  .hero {
    padding: 72px 24px 40px;
    text-align: center;
  }
  .kicker {
    margin: 0 0 12px;
    letter-spacing: .12em;
    text-transform: uppercase;
    font-size: 12px;
    color: rgb(var(--gray));
  }
  .hero h1 {
    margin: 0 0 16px;
    font-size: clamp(34px, 5vw, 54px);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .lead {
    margin: 0 auto 24px;
    max-width: 56ch;
    font-size: 18px;
    color: rgb(var(--gray));
  }
  .heroActions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btnPrimary,
  .btnGhost {
    display: inline-block;
    padding: 12px 16px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 700;
  }
  .btnPrimary {
    background: rgba(255, 255, 255, 0.25);
    color: white;
    border: 2px solid rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(4px);
  }
  .btnPrimary:hover {
    background: rgba(255, 255, 255, 0.4);
  }
  .btnGhost {
    border: 1px solid rgba(var(--gray), 35%);
    color: rgb(var(--gray-dark));
    background: rgba(255,255,255,.7);
  }

  .section {
    padding: 32px 24px;
  }
  .sectionTitle {
    margin: 0 0 16px;
    font-size: 22px;
  }

  .grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .card {
    background: white;
    border-radius: 16px;
    padding: 0;
    box-shadow: var(--box-shadow);
    overflow: hidden;
  }
  .cardThumb {
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-radius: 0;
    display: block;
    margin: 0;
  }
  .cardBody {
    padding: 16px 20px 20px;
  }
  .cardBody p {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.85em;
    color: rgb(var(--gray));
    margin: 0;
  }
  .cardBody h3 {
    font-size: 1em;
    margin: 0 0 8px;
    line-height: 1.4;
  }
  .cardCats {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 10px;
  }
  .catBadge {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.03em;
    border-radius: 100px;
    padding: 3px 10px;
    border: 1px solid currentColor;
  }
  .catBadge[data-cat="ハウス暮らし"] { color: #d97706; background: #fffbeb; }
  .catBadge[data-cat="イベント"]     { color: #7c3aed; background: #f5f3ff; }
  .catBadge[data-cat="ゲスト"]       { color: #059669; background: #ecfdf5; }
  .catBadge[data-cat="改装・設備"]   { color: #b45309; background: #fdf6e3; }
  .catBadge[data-cat="商店街"]       { color: #dc2626; background: #fff5f5; }

  .linkCard {
    text-decoration: none;
    color: inherit;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .linkCard:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0,0,0,.12);
  }
.hero {
  padding: 48px 24px 24px;
  text-align: center;
}

.heroImage {
  display: block;
  width: 100%;
  max-width: 1080px;
  height: clamp(260px, 46vw, 520px);
  object-fit: cover;
  border-radius: 20px;
  margin: 28px auto 0;
  box-shadow: 0 18px 60px rgba(0,0,0,.12);
}
.heroOverlay {
  position: relative;
  padding: 0;
}

.heroOverlay .heroImage {
  width: 100%;
  max-width: 100%;
  height: auto;
  aspect-ratio: 1189 / 438;
  object-fit: cover;
  object-position: center center;
  border-radius: 0;
  margin: 0 auto;
  display: block;
  filter: brightness(0.82);
}

.heroOverlay .heroText {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 24px;
  text-align: center;
  color: white;
}

.heroOverlay .kicker {
  color: rgba(255,255,255,.8);
}

.heroOverlay h1 {
  color: white;
  text-shadow: 0 6px 24px rgba(0,0,0,.35);
}

.heroOverlay .lead {
  color: rgba(255,255,255,.9);
}

.heroOverlay .btnGhost {
  border-color: rgba(255,255,255,.6);
  color: white;
  background: rgba(0,0,0,.25);
}

/* --- モバイル専用ヒーロー要素（PCでは存在しないものとして扱う） --- */
/* .heroMedia は PC では素の block。ラッパーが増えるだけで従来のレイアウトは変わらない。 */
.heroTile { display: none; }
.heroFacts { display: none; }
.muted {
  color: rgb(var(--gray));
  font-size: 14px;
}

.instaGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-top: 16px;
}

.instaGrid img {
  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  border-radius: 12px;
}
.infoGrid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 16px;
  margin-top: 16px;
}

.infoCard {
  display: block;
  padding: 22px 20px;
  border-radius: 16px;
  background: white;
  box-shadow: var(--box-shadow);
  text-decoration: none;
  color: inherit;
  transition: transform .15s ease, box-shadow .15s ease;
}

.infoCard:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 28px rgba(0,0,0,.12);
}

.infoKicker {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 6px;
}

.infoTitle {
  font-size: 16px;
  font-weight: 700;
  margin-bottom: 6px;
  color: rgb(var(--gray-dark));
}

.infoDesc {
  font-size: 13px;
  color: rgb(var(--gray));
  line-height: 1.5;
}
.section {
  padding: 32px;
  background: linear-gradient(
    180deg,
    rgba(var(--gray-light), 0.6),
    rgba(var(--gray-light), 0.2)
  );
  border-radius: 24px;
  margin-top: 32px;
}
.aboutStats {
  display: flex;
  gap: 32px;
  margin: 20px 0 16px;
  padding: 20px 0;
  border-top: 1px solid #eee;
  border-bottom: 1px solid #eee;
}
.aboutStats div {
  display: flex;
  align-items: baseline;
  gap: 4px;
}
.statNum {
  font-size: 1.8rem;
  font-weight: 700;
  color: #1a1a2e;
}
.statLabel {
  font-size: 0.85rem;
  color: #666;
}
.aboutLink {
  display: inline-block;
  margin-top: 12px;
  padding: 10px 0;
  font-size: 0.9rem;
  font-weight: 600;
  color: #3355cc;
  text-decoration: none;
}
.aboutLink:hover { text-decoration: underline; }

/* モバイル用の追従CTA（PCでは非表示） */
.stickyCta { display: none; }

@media (max-width: 600px) {
  /* ヒーローを「コピー帯 → 写真モザイク → 実データ帯」の縦積みに組み替える。
     テキストの重ね置き（position:absolute）を解除するのが起点。 */
  .heroOverlay {
    position: static;
    display: flex;
    flex-direction: column;
    padding: 0 0 4px;
  }
  .heroOverlay .heroText {
    order: 1;
    position: static;
    inset: auto;
    display: block;
    padding: 14px 16px 12px;
    text-align: left;
    color: inherit;
  }
  .heroOverlay .kicker {
    margin: 0 0 6px;
    color: var(--accent);
    font-weight: 700;
    font-size: 11px;
  }
  .heroOverlay h1 {
    font-size: 1.42em;
    line-height: 1.28;
    margin: 0 0 8px;
    color: rgb(var(--gray-dark));
    text-shadow: none;
  }
  .heroOverlay .lead {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: rgb(var(--gray));
  }
  /* CTAは画面下の追従バー（.stickyCta）が常時出ているので、
     ファーストビューを写真と数値に使うためヒーロー内の重複ボタンは出さない。 */
  .heroOverlay .heroActions { display: none; }

  /* 写真モザイク: 上に賑わい1枚（全幅）、下に暮らし2枚（2列） */
  .heroMedia {
    order: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    padding: 0 12px;
  }
  .heroOverlay .heroImage {
    grid-column: 1 / -1;
    width: 100%;
    height: auto;
    min-height: 0;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: center 45%;
    border-radius: 14px;
    filter: none;
    box-shadow: 0 6px 18px rgba(0,0,0,.10);
  }
  .heroTile {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 14px;
    box-shadow: 0 6px 18px rgba(0,0,0,.10);
  }

  /* 実データ帯: 家賃・部屋数・アクセスを3列で。数値は pricing.mjs 由来 */
  .heroFacts {
    order: 3;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: center;
    list-style: none;
    margin: 12px 12px 0;
    padding: 10px 4px;
    border: 1px solid rgba(35, 55, 255, .18);
    background: rgba(35, 55, 255, .05);
    border-radius: 14px;
  }
  .heroFacts li {
    min-width: 0;
    padding: 0 6px;
    text-align: center;
  }
  .heroFacts li + li { border-left: 1px solid rgba(35, 55, 255, .18); }
  .heroFacts b {
    display: block;
    font-size: 13px;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--accent);
  }
  .heroFacts span {
    display: block;
    margin-top: 2px;
    font-size: 10px;
    line-height: 1.3;
    color: rgb(var(--gray));
  }

  /* セクション余白の圧縮（16:9でない縦長画面で本文幅を確保する） */
  main { padding: 12px !important; }
  .section { padding: 22px 16px; margin-top: 20px; border-radius: 18px; }

  /* ブログカードはモバイルでは横並びの小型カードにする
     （縦積みの大型カードはファーストビュー級の面積を食うため） */
  .grid { gap: 10px; }
  .linkCard { display: flex; align-items: stretch; }
  .cardThumb { width: 108px; min-width: 108px; height: auto; object-fit: cover; }
  .cardBody { padding: 10px 12px; min-width: 0; }
  .cardBody h3 {
    font-size: 0.9em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .cardBody p { -webkit-line-clamp: 2; font-size: 0.78em; }
  .cardCats { margin-bottom: 6px; }
  .catBadge { font-size: 10px; padding: 2px 8px; }

  .aboutStats { gap: 18px; flex-wrap: wrap; }
}

@media (max-width: 720px) {
  body { padding-bottom: 72px; }
  .stickyCta {
    display: block;
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 60;
    padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(8px);
    border-top: 1px solid rgb(var(--gray-light));
  }
  .stickyCtaBtn {
    display: block;
    width: 100%;
    box-sizing: border-box;
    padding: 14px 20px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: 16px;
    text-align: center;
    text-decoration: none;
    box-shadow: 0 6px 18px rgba(35, 55, 255, 0.28);
  }
}
