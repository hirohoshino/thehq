---
// 神戸大学生・受験生向けランディングページ（LP）
// 方針: グローバルナビ無し / 外部への回遊リンク0 / CTAは「見学を申し込む」1本 /
//       フォームはページ内に埋め込み、hq_attr（gclid・utm・referrer）を付与して送信する。
import BaseHead from '../components/BaseHead.astro';
import AvailabilityBanner from '../components/AvailabilityBanner.astro';
import {
  rentRange,
  commonFeeYen,
  monthlyBand,
  totalRange,
  minRent,
  maxRent,
  commonFee,
  totalMin,
  totalMax,
  asOf,
} from '../data/pricing.mjs';

const fmt = (n) => Number(n).toLocaleString('en-US');

// 費用バーの幅（SVG座標）: 最大月額を基準に按分する
const BAR_W = 560;
const wRentMax = Math.round((maxRent / totalMax) * BAR_W);
const wRentMin = Math.round((minRent / totalMax) * BAR_W);
const wFee = Math.round((commonFee / totalMax) * BAR_W);

const title = '神戸大学の学生に人気のシェアハウス｜The Headquarters Kobe（灘区・水道筋）';
const description =
  `神戸大学へ通える灘区・水道筋のシェアハウス。市バス乗り継ぎなら片道210円で神大正門前へ。家具付き・月${monthlyBand}・初期費用は計5万円、礼金/仲介手数料なし・保証人原則不要。神大生・受験生の一人暮らしに。`;

const faqs = [
  { q: 'HQから神戸大学へ通えますか？', a: 'はい。HQは神戸大学と三宮のちょうど中間、灘区にあります。最寄りの「水道筋3丁目」バス停は徒歩1分で、市バス乗り継ぎなら片道210円で神大正門前まで。阪急王子公園駅・JR摩耶駅も徒歩6〜7分、自転車でも通えます。' },
  { q: '毎月かかる費用はどれくらいですか？', a: `家賃は${rentRange}。これに共益費${commonFeeYen}（水道光熱費・ネット・消耗品込み）を加えて、毎月の支払いは${monthlyBand}（部屋により${totalRange}）です。` },
  { q: '入居時の初期費用は？', a: '契約手数料・清掃費とデポジットで計5万円のみ。デポジットは退去時に問題がなければ全額返金します。礼金・仲介手数料はいただきません。' },
  { q: '保証人は必要ですか？', a: '連帯保証人は原則不要です。契約に必要なのは本人確認書類と印鑑、緊急連絡先のみです。' },
  { q: '家具や家電は自分で用意しますか？', a: 'ベッド・布団・机・イス・エアコンは各部屋に備え付け。生活に必要な設備も揃っているので、バッグ1つですぐに暮らし始められます。' },
  { q: '合格前・受験前でも相談できますか？', a: 'もちろんです。まずは見学に来てメンバーと話すだけでも歓迎します。満室のときは空き待ち登録をしておくと、空室が出た際に優先してご案内します。' },
  { q: '短期の入居はできますか？', a: '基本は6ヶ月以上を想定していますが、短期のご相談も可能です（基本家賃より割増の場合あり）。留学や半年だけの滞在で住んだ神大生もいます。' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<html lang="ja">
  <head>
    <BaseHead title={title} description={description} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="lp">
    <!-- LP用の最小ヘッダー: ロゴのみ。グローバルナビは置かない -->
    <header class="lpBar">
      <div class="lpBarInner">
        <span class="lpBrand">
          <img src="/images/logo.png" alt="The Headquarters Kobe" width="26" height="26" />
          <span>The Headquarters Kobe</span>
        </span>
        <a class="btn btnPrimary btnSm" href="#entry">見学を申し込む</a>
      </div>
    </header>

    <!-- Hero -->
    <section class="hero">
      <img src="/images/hero.jpg" alt="The Headquarters Kobe のリビング" class="heroImg" />
      <div class="heroInner">
        <p class="kicker">FOR KOBE UNIVERSITY STUDENTS</p>
        <h1>神戸のど真ん中で、<br />学生生活を。</h1>
        <p class="heroLead">
          神戸大学にも、三宮にも、水道筋商店街にも近い。<br />灘区のシェアハウス The Headquarters Kobe。
        </p>
        <a class="btn btnPrimary btnLg" href="#entry">見学を申し込む（無料）</a>
        <p class="heroNote">まずは見に来るだけでOK。しつこい営業はしません。</p>
      </div>
    </section>

    <!-- 数値サマリー -->
    <section class="stats">
      <div class="statsInner">
        <div class="stat"><div class="statNum">月{monthlyBand}</div><div class="statCap">家賃＋共益費（水道光熱・ネット込）</div></div>
        <div class="stat"><div class="statNum">初期費用 5万円</div><div class="statCap">礼金・仲介手数料は0円</div></div>
        <div class="stat"><div class="statNum">神大まで 210円</div><div class="statCap">市バス乗り継ぎ・片道</div></div>
        <div class="stat"><div class="statNum">保証人 原則不要</div><div class="statCap">家具・家電つき</div></div>
      </div>
    </section>

    <main class="wrap">
      <AvailabilityBanner lang="ja" />

      <!-- ① 立地 -->
      <section class="sec">
        <p class="secKicker">LOCATION</p>
        <h2 class="secTitle">大学にも、三宮にも、商店街にも。<br class="brSp" />3つの「近い」が同時に揃う場所</h2>
        <p class="secLead">
          神大生に「HQの良かったところ」を聞くと、多くが同じ3つを挙げます。大学に近いこと、神戸の中心・三宮に近いこと、そして足元の商店街で毎日の暮らしがしやすいこと。
        </p>

        <figure class="fig">
          <svg class="figSvg" viewBox="0 0 760 400" role="img" aria-label="HQを中心に、神戸大学・三宮・水道筋商店街への距離を示した図">
            <defs>
              <linearGradient id="gHq" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#2337ff" />
                <stop offset="100%" stop-color="#5a6bff" />
              </linearGradient>
            </defs>
            <rect x="0" y="0" width="760" height="400" rx="18" fill="#f7f8fc" />

            <!-- 接続線 -->
            <line x1="380" y1="200" x2="380" y2="95" class="ln" />
            <line x1="380" y1="200" x2="608" y2="318" class="ln" />
            <line x1="380" y1="200" x2="152" y2="318" class="ln" />

            <!-- 神戸大学 -->
            <rect x="286" y="52" width="188" height="52" rx="12" class="node" />
            <text x="380" y="74" class="tNode">神戸大学（六甲台）</text>
            <text x="380" y="92" class="tNodeSub">六甲台キャンパス</text>
            <text x="396" y="145" class="tEdge">バス乗り継ぎ 約25分</text>
            <text x="396" y="163" class="tEdgeStrong">片道 210円</text>

            <!-- 三宮 -->
            <rect x="524" y="292" width="168" height="52" rx="12" class="node" />
            <text x="608" y="314" class="tNode">三宮</text>
            <text x="608" y="332" class="tNodeSub">神戸の中心街</text>
            <text x="478" y="252" class="tEdge">徒歩＋電車で 約10分</text>

            <!-- 水道筋商店街 -->
            <rect x="60" y="292" width="184" height="52" rx="12" class="node" />
            <text x="152" y="314" class="tNode">水道筋商店街</text>
            <text x="152" y="332" class="tNodeSub">八百屋・スーパー・銭湯</text>
            <text x="190" y="252" class="tEdgeStrong">徒歩 0分</text>

            <!-- HQ -->
            <rect x="278" y="172" width="204" height="58" rx="14" fill="url(#gHq)" />
            <text x="380" y="197" class="tHq">The Headquarters Kobe</text>
            <text x="380" y="216" class="tHqSub">兵庫県神戸市灘区</text>
          </svg>
        </figure>

        <div class="grid3">
          <div class="card">
            <h3>大学に近い</h3>
            <p>HQは神戸大学と三宮のちょうど中間。徒歩1分の「水道筋3丁目」バス停から乗り継げば片道210円で神大正門前へ。阪急王子公園駅・JR摩耶駅も徒歩6〜7分、自転車でも通えます。</p>
          </div>
          <div class="card">
            <h3>三宮に近い</h3>
            <p>三ノ宮まで約10分。授業終わりの遊びも、バイト探しも、買い物も映画も。神戸の中心がすぐそこにある学生生活。</p>
          </div>
          <div class="card">
            <h3>商店街が足元</h3>
            <p>活気ある水道筋商店街のど真ん中。安い八百屋やスーパー、炭酸泉の銭湯・灘温泉まで徒歩圏。毎日の生活が歩いて完結します。</p>
          </div>
        </div>

        <blockquote class="quote">
          「交通のアクセスがいい。他の国公立は都心から離れた場所が多いけど、神大は遊びもバイト探しもイベントも映画も行きやすい」
          <cite>H.G.さん／国際人間科学部</cite>
        </blockquote>
      </section>

      <!-- ② 通学ルート -->
      <section class="sec secAlt">
        <p class="secKicker">COMMUTE</p>
        <h2 class="secTitle">神大までの通学は、3ルート。<br class="brSp" />学生のおすすめは「バス乗り継ぎ」</h2>
        <p class="secLead">
          市バスはICカードで乗り継ぐと2区間目が無料。だから片道210円で神大正門前まで行けます。混みやすい36系統も、阪急六甲の一つ手前「六甲口」から乗るので座れる確率が高い、というのが住人の評価です。
        </p>

        <figure class="fig">
          <svg class="figSvg" viewBox="0 0 760 350" role="img" aria-label="HQから神戸大学への3つの通学ルート。所要時間・運賃・移動手段を示した図">
            <defs>
              <symbol id="icoWalk" viewBox="0 0 24 24">
                <circle cx="12.5" cy="4.4" r="2.3" fill="currentColor" />
                <path d="M12.2 8 L11.6 13.2 M12.2 8 L8.7 10.7 M12.2 8 L15.3 11.7 L17.4 11 M11.6 13.2 L8.5 19.8 M11.6 13.2 L14.5 15.6 L15.3 19.8" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
              </symbol>
              <symbol id="icoBus" viewBox="0 0 24 24">
                <rect x="3.5" y="3.5" width="17" height="13.5" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.9" />
                <line x1="3.5" y1="11.5" x2="20.5" y2="11.5" stroke="currentColor" stroke-width="1.9" />
                <circle cx="8" cy="19.8" r="1.7" fill="currentColor" />
                <circle cx="16" cy="19.8" r="1.7" fill="currentColor" />
              </symbol>
              <symbol id="icoTrain" viewBox="0 0 24 24">
                <rect x="5" y="2.8" width="14" height="14.6" rx="3.6" fill="none" stroke="currentColor" stroke-width="1.9" />
                <rect x="8.1" y="5.8" width="7.8" height="4.6" rx="1" fill="currentColor" />
                <circle cx="9.3" cy="13.9" r="1.25" fill="currentColor" />
                <circle cx="14.7" cy="13.9" r="1.25" fill="currentColor" />
                <path d="M8.2 21 L10.1 17.4 M15.8 21 L13.9 17.4" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
              </symbol>
            </defs>
            <rect x="0" y="0" width="760" height="350" rx="18" fill="#f7f8fc" />

            <!-- ルート1: バス乗り継ぎ（おすすめ） -->
            <rect x="24" y="46" width="712" height="88" rx="12" class="lane laneBest" />
            <rect x="40" y="56" width="74" height="22" rx="11" class="pill" />
            <text x="77" y="71" class="tPill">おすすめ</text>
            <text x="40" y="104" class="tTime">約25分</text>
            <text x="40" y="124" class="tFareSub">片道 210円</text>
            <line x1="200" y1="80" x2="700" y2="80" class="route routeBest" />
            <circle cx="200" cy="80" r="7" class="dot dotBest" />
            <circle cx="366" cy="80" r="6" class="dot dotBest" />
            <circle cx="533" cy="80" r="6" class="dot dotBest" />
            <circle cx="700" cy="80" r="7" class="dot dotBest" />
            <text x="200" y="64" class="tStop">HQ</text>
            <text x="366" y="64" class="tStop">水道筋3丁目</text>
            <text x="533" y="64" class="tStop">六甲口</text>
            <text x="700" y="64" class="tStop" text-anchor="end">神大正門前</text>
            <use href="#icoWalk" x="273" y="88" width="19" height="19" class="ico icoBest" />
            <use href="#icoBus" x="440" y="88" width="19" height="19" class="ico icoBest" />
            <use href="#icoBus" x="607" y="88" width="19" height="19" class="ico icoBest" />
            <text x="283" y="124" class="tSeg">徒歩1分</text>
            <text x="450" y="124" class="tSeg">市バス 92系統</text>
            <text x="616" y="124" class="tSeg">36系統に乗換</text>

            <!-- ルート2: JR -->
            <rect x="24" y="150" width="712" height="88" rx="12" class="lane" />
            <text x="40" y="198" class="tTime tTimeSub">約30分</text>
            <text x="40" y="218" class="tFareSub">片道 340円</text>
            <line x1="200" y1="184" x2="700" y2="184" class="route" />
            <circle cx="200" cy="184" r="7" class="dot" />
            <circle cx="366" cy="184" r="6" class="dot" />
            <circle cx="533" cy="184" r="6" class="dot" />
            <circle cx="700" cy="184" r="7" class="dot" />
            <text x="200" y="168" class="tStop">HQ</text>
            <text x="366" y="168" class="tStop">JR摩耶</text>
            <text x="533" y="168" class="tStop">JR六甲道</text>
            <text x="700" y="168" class="tStop" text-anchor="end">神大正門前</text>
            <use href="#icoWalk" x="273" y="192" width="19" height="19" class="ico" />
            <use href="#icoTrain" x="440" y="192" width="19" height="19" class="ico" />
            <use href="#icoBus" x="607" y="192" width="19" height="19" class="ico" />
            <text x="283" y="228" class="tSeg">徒歩6分</text>
            <text x="450" y="228" class="tSeg">JR神戸線</text>
            <text x="616" y="228" class="tSeg">市バス36系統</text>

            <!-- ルート3: 阪急 -->
            <rect x="24" y="254" width="712" height="88" rx="12" class="lane" />
            <text x="40" y="302" class="tTime tTimeSub">約30分</text>
            <text x="40" y="322" class="tFareSub">片道 370円</text>
            <line x1="200" y1="288" x2="700" y2="288" class="route" />
            <circle cx="200" cy="288" r="7" class="dot" />
            <circle cx="366" cy="288" r="6" class="dot" />
            <circle cx="533" cy="288" r="6" class="dot" />
            <circle cx="700" cy="288" r="7" class="dot" />
            <text x="200" y="272" class="tStop">HQ</text>
            <text x="366" y="272" class="tStop">阪急王子公園</text>
            <text x="533" y="272" class="tStop">阪急六甲</text>
            <text x="700" y="272" class="tStop" text-anchor="end">神大正門前</text>
            <use href="#icoWalk" x="273" y="296" width="19" height="19" class="ico" />
            <use href="#icoTrain" x="440" y="296" width="19" height="19" class="ico" />
            <use href="#icoBus" x="607" y="296" width="19" height="19" class="ico" />
            <text x="283" y="332" class="tSeg">徒歩7分</text>
            <text x="450" y="332" class="tSeg">阪急神戸線</text>
            <text x="616" y="332" class="tSeg">市バス36系統</text>
          </svg>
          <figcaption>所要時間は乗り継ぎ・時間帯により前後します。このほか、自転車・原付でも通えます。帰りは下り坂なので、歩いて30分弱かけて帰る住人も。</figcaption>
        </figure>
      </section>

      <!-- ③ 費用 -->
      <section class="sec">
        <p class="secKicker">COST</p>
        <h2 class="secTitle">毎月{monthlyBand}、入居時は5万円だけ。</h2>
        <p class="secLead">
          家賃に共益費を足した金額が、そのまま毎月の支払いです。水道光熱費もネットもトイレットペーパーも込み。ワンルームを借りて家具・家電を揃え、礼金や仲介手数料を払うより、始めやすく、毎月の負担も軽くなります。
        </p>

        <figure class="fig">
          <svg class="figSvg" viewBox="0 0 760 330" role="img" aria-label="毎月の費用の内訳と、入居時にかかる初期費用の内訳を示した図">
            <rect x="0" y="0" width="760" height="330" rx="18" fill="#f7f8fc" />

            <!-- 毎月 -->
            <text x="40" y="46" class="tSecLabel">毎月の支払い</text>
            <text x="720" y="46" class="tTotal" text-anchor="end">{totalRange}</text>

            <rect x={40} y={66} width={wRentMax} height="44" rx="8" fill="#2337ff" />
            <rect x={40 + wRentMax} y={66} width={wFee} height="44" rx="8" fill="#9aa6ff" />
            <line x1={40 + wRentMin} y1="60" x2={40 + wRentMin} y2="116" class="tick" />

            <text x={40 + wRentMax / 2} y="94" class="tBar">家賃 {fmt(minRent)}〜{fmt(maxRent)}円</text>
            <text x={40 + wRentMax + wFee / 2} y="94" class="tBarSm">共益費</text>
            <text x={40 + wRentMax + wFee / 2} y="132" class="tUnder">{fmt(commonFee)}円</text>
            <text x={40 + wRentMin} y="132" class="tUnder" text-anchor="middle">最安の部屋</text>
            <text x="40" y="158" class="tNote">共益費に含まれるもの：水道・電気・ガス・インターネット・共用部の消耗品・清掃</text>

            <!-- 初期費用 -->
            <text x="40" y="212" class="tSecLabel">入居時にかかる費用</text>
            <text x="720" y="212" class="tTotal" text-anchor="end">合計 50,000円</text>

            <rect x="40" y="232" width="330" height="44" rx="8" fill="#2337ff" />
            <rect x="378" y="232" width="330" height="44" rx="8" fill="#c9cffb" />
            <text x="205" y="260" class="tBar">契約手数料・清掃費 25,000円</text>
            <text x="543" y="256" class="tBarDark">デポジット 25,000円</text>
            <text x="543" y="271" class="tBarDarkSm">退去時に問題がなければ全額返金</text>

            <text x="40" y="306" class="tZero">礼金 0円</text>
            <text x="150" y="306" class="tZero">仲介手数料 0円</text>
            <text x="310" y="306" class="tZero">家具・家電 0円</text>
            <text x="450" y="306" class="tZero">連帯保証人 原則不要</text>
          </svg>
          <figcaption>金額は{asOf}のものです。部屋ごとの家賃は見学時にご案内します。</figcaption>
        </figure>
      </section>

      <!-- ④ 暮らし -->
      <section class="sec secAlt">
        <p class="secKicker">LIFE</p>
        <h2 class="secTitle">勉強も、暮らしも。</h2>
        <div class="photoRow">
          <img src="/images/insta-1.jpg" alt="キッチンで料理をする住人たち" loading="lazy" />
          <img src="/images/insta-2.jpg" alt="屋上で過ごす住人たち" loading="lazy" />
          <img src="/images/insta-3.jpg" alt="桜の下でのハウスイベント" loading="lazy" />
        </div>
        <div class="grid4">
          <div class="feat"><h3>個室にロフトベッド＋勉強机</h3><p>眠る場所と勉強する場所を分けられる、集中できる自分の部屋。</p></div>
          <div class="feat"><h3>広いリビングと揃ったキッチン</h3><p>自炊で食費を抑えつつ、誰かと食卓を囲める。ひとりで抱え込まない暮らし。</p></div>
          <div class="feat"><h3>屋上でBBQ・プール</h3><p>授業や研究の合間の息抜き。摩耶山・六甲もすぐそば。</p></div>
          <div class="feat"><h3>世界中の住人と国際交流</h3><p>国際色ゆたかな神大と相性よく、英語を使う機会も日常に。「国内留学」感覚で。</p></div>
        </div>
      </section>

      <!-- ⑤ 社会的証明 -->
      <section class="sec">
        <p class="secKicker">VOICES</p>
