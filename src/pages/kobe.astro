</div>



    <script is:inline>
(function () {
  'use strict';

  /* ---- 1. IntersectionObserver: .reveal / .stamp-in をふわっと表示 ---- */
  var animated = document.querySelectorAll('.reveal, .stamp-in');
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
    animated.forEach(function (el) {
      if (!el.classList.contains('is-visible')) { io.observe(el); }
    });
  } else {
    animated.forEach(function (el) { el.classList.add('is-visible'); });
  }

  /* ---- 2. FAQアコーディオン開閉(detailsをmax-heightでアニメーション) ---- */
  document.querySelectorAll('details.s13-item').forEach(function (item) {
    var summary = item.querySelector('summary');
    var body = item.querySelector('.s13-item__body');
    if (!summary || !body) { return; }
    body.style.overflow = 'hidden';
    body.style.transition = 'max-height .3s ease, opacity .3s ease';
    body.style.maxHeight = item.open ? body.scrollHeight + 'px' : '0px';
    body.style.opacity = item.open ? '1' : '0';
    summary.addEventListener('click', function (e) {
      e.preventDefault();
      if (item.open) {
        body.style.maxHeight = body.scrollHeight + 'px';
        requestAnimationFrame(function () {
          body.style.maxHeight = '0px';
          body.style.opacity = '0';
        });
        body.addEventListener('transitionend', function onEnd(ev) {
          if (ev.propertyName === 'max-height') {
            item.open = false;
            body.removeEventListener('transitionend', onEnd);
          }
        });
      } else {
        item.open = true;
        body.style.maxHeight = '0px';
        body.style.opacity = '0';
        requestAnimationFrame(function () {
          body.style.maxHeight = body.scrollHeight + 'px';
          body.style.opacity = '1';
        });
      }
    });
  });

  /* ---- 3. スムーススクロール(ページ内アンカー) ---- */
  document.querySelectorAll('a[href^="#"]').forEach(function (link) {
    link.addEventListener('click', function (e) {
      var id = link.getAttribute('href');
      if (id.length < 2) { return; }
      var target = document.querySelector(id);
      if (!target) { return; }
      e.preventDefault();
      closeMenu();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  /* ---- 4. SPハンバーガーメニュー ---- */
  var burger = document.querySelector('.s01-burger');
  var menu = document.getElementById('sp-menu');
  function closeMenu() {
    if (!menu) { return; }
    menu.classList.remove('is-open');
    menu.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('sp-menu-open');
    if (burger) { burger.setAttribute('aria-expanded', 'false'); }
  }
  if (burger && menu) {
    burger.setAttribute('aria-expanded', 'false');
    burger.setAttribute('aria-controls', 'sp-menu');
    burger.addEventListener('click', function () {
      var open = menu.classList.toggle('is-open');
      menu.setAttribute('aria-hidden', open ? 'false' : 'true');
      document.body.classList.toggle('sp-menu-open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      burger.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
    });
  }

  /* ---- 5. モバイル用スティッキー底部CTAバー(ヒーロー通過で表示・最終CTAで隠す) ---- */
  var bar = document.getElementById('sp-cta-bar');
  var hero = document.getElementById('hero');
  var finalCta = document.getElementById('cta');
  if (bar && 'IntersectionObserver' in window) {
    var heroPassed = false;
    var ctaInView = false;
    var update = function () {
      bar.classList.toggle('is-shown', heroPassed && !ctaInView);
    };
    if (hero) {
      new IntersectionObserver(function (entries) {
        heroPassed = !entries[0].isIntersecting;
        update();
      }, { threshold: 0 }).observe(hero);
    } else {
      heroPassed = true; update();
    }
    if (finalCta) {
      new IntersectionObserver(function (entries) {
        ctaInView = entries[0].isIntersecting;
        update();
      }, { threshold: 0.2 }).observe(finalCta);
    }
  } else if (bar) {
    bar.classList.add('is-shown');
  }

  /* ---- 6. CTAクリックをGA4に送る(event_label でLPを識別) ---- */
  document.querySelectorAll('a[href^="/contact"]').forEach(function (a) {
    a.addEventListener('click', function () {
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'cta_click', {
          event_label: 'kobe-lp',
          link_text: (a.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 40)
        });
      }
    });
  });
})();
</script>
  </body>
