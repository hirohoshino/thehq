---
// 広告着地用の総合LP(POP! FES! HQ)。
// 方針: 自己完結(global.css は読み込まない) / グローバルナビ無し / CTAは /contact/ 1本。
// canonical はトップ(/)に向ける ＝ 内容が重複するトップとインデックスを食い合わせない。
// 価格は src/data/rooms.json が単一ソース。ベタ書きは置かない。
import LpHead from '../components/LpHead.astro';
import { rents, minRentYen, maxRentYen, commonFeeYen } from '../data/pricing.mjs';

const yen = (n) => '¥' + Number(n).toLocaleString('en-US');

const title =
  `The Headquarters Kobe(HQ)｜神戸・水道筋商店街のシェアハウス — 家賃${minRentYen}〜・全10室個室`;
const description =
  `集まって、笑って、みんなで育つシェアハウス。神戸・水道筋商店街のアーケード内シェアハウス「The Headquarters Kobe(HQ)」。家賃${minRentYen}〜・全10室個室、屋上BBQ・充実キッチン家電、王子公園駅・摩耶駅から徒歩7分で神戸大学にも好アクセス。初期費用5万円、礼金・仲介手数料ゼロ。`;
const ogDescription =
  `朝の「おはよう」から夜の「ただいま」「おかえり」まで、誰かがいる。家賃${minRentYen}〜・全10室個室・屋上BBQ。神戸大生・新社会人へ、水道筋のフェスみたいな毎日を。`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- 重複コンテンツ回避: 正はトップ -->
    <link rel="canonical" href="https://theheadquarters.jp/" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Headquarters Kobe" />
    <meta property="og:title" content="The Headquarters Kobe(HQ)｜神戸・水道筋商店街のシェアハウス" />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content="https://theheadquarters.jp/kobe/" />
    <meta property="og:image" content="https://theheadquarters.jp/images/hero.jpg" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/images/logo.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Google Fontsは日本語4ファミリー分の@font-face定義だけでCSS約770KBあり、
        rel="stylesheet" のままだと低速回線でFCP15秒/LCP17.6秒(2026-07-29実測)。
        media="print"→onloadで昇格させて非ブロッキングにする。display=swapなので
        本文はフォールバックで即描画され、到着後に差し替わる。 */}
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@500;800;900&family=Mochiy+Pop+One&family=Zen+Maru+Gothic:wght@500;700&family=Zen+Kurenaido&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@500;800;900&family=Mochiy+Pop+One&family=Zen+Maru+Gothic:wght@500;700&family=Zen+Kurenaido&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@500;800;900&family=Mochiy+Pop+One&family=Zen+Maru+Gothic:wght@500;700&family=Zen+Kurenaido&display=swap"
      />
    </noscript>
    <link rel="preload" as="image" href="/wp-content/uploads/2019/11/%E3%81%AA%E3%81%B9-1-1024x768.webp" fetchpriority="high" />

    <!-- GA4 / Clarity / 流入元(gclid・utm)の捕捉 -->
    <LpHead />

    <style is:inline>
/* ================= tokens.css ================= */
/* =========================================================================
   The Headquarters Kobe LP — Design Tokens & Common Utilities
   コンセプト: 「POP! FES! HQ — 水道筋フェスマガジン」
   design-spec.md 準拠。読み込みは <link rel="stylesheet" href="tokens.css">
   フォントは別途 Google Fonts の <link> をHTML側<head>に追加すること:
   https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@500;800;900
   &family=Mochiy+Pop+One&family=Zen+Maru+Gothic:wght@500;700&family=Zen+Kurenaido&display=swap
   ========================================================================= */

/* -------------------------------------------------------------------------
   1. カラートークン(60:30:10)
   ------------------------------------------------------------------------- */
:root {
  /* 60% — 下地 */
  --color-cream:        #FFF6E9; /* クリーム紙地。全体のベース背景 */
  --color-paper:        #FFFDF8; /* ポラロイド白フチ・カード面 */

  /* 30% — 主役色+インク */
  --color-orange:       #FF6B35; /* サンセットオレンジ。斜め帯・CTA・見出しマーカー */
  --color-ink:          #1B1B3A; /* 濃紺インク。本文・太罫線・手書き注釈 */

  /* 10% — 差し色 */
  --color-yellow:       #FFD23F; /* レモンイエロー。バッジ・マーカー下線 */
  --color-teal:         #2EC4B6; /* ターコイズ。吹き出し・丸囲み・ステッカー縁 */

  /* 派生(透明度違い。色数は増やさない) */
  --color-orange-soft:    rgba(255, 107, 53, .12);  /* セクション背景の淡オレンジ */
  --color-teal-soft:      rgba(46, 196, 182, .12);   /* セクション背景の淡ターコイズ */
  --color-yellow-soft:    rgba(255, 210, 63, .20);   /* 値札POP用の黄味クリーム */
  --color-yellow-marker:  rgba(255, 210, 63, .65);   /* 蛍光マーカー下線 */
  --color-ink-grid:       rgba(27, 27, 58, .06);     /* 方眼・ドット地紋 */
  --color-cta-shadow:     #d14f1f;                    /* CTA押し込み影の芯色 */

  /* -----------------------------------------------------------------------
     2. フォントトークン
     ----------------------------------------------------------------------- */
  --font-heading: 'M PLUS Rounded 1c', 'Hiragino Maru Gothic ProN', sans-serif; /* 見出し 800/900 */
  --font-display: 'Mochiy Pop One', var(--font-heading);                        /* 特大数字・ステッカー・スタンプ */
  --font-body:    'Zen Maru Gothic', 'Hiragino Maru Gothic ProN', sans-serif;   /* 本文 500/700 */
  --font-hand:    'Zen Kurenaido', var(--font-body);                            /* 手書き注釈・キャプション */
  --font-en:      'M PLUS Rounded 1c', sans-serif;                              /* 英字アクセント(トラッキング広め) */

  /* -----------------------------------------------------------------------
     3. 余白・角丸・影スケール(8pxベース)
     ----------------------------------------------------------------------- */
  --sp-1: 8px;
  --sp-2: 16px;
  --sp-3: 24px;
  --sp-4: 40px;
  --sp-5: 64px;  /* SP時のセクション上下パディング */
  --sp-6: 96px;  /* PC時のセクション上下パディング */

  --r-sm:   8px;   /* バッジ内要素・入力欄 */
  --r-md:   16px;  /* カード・数字タイル */
  --r-lg:   28px;  /* CTAボタン・吹き出し */
  --r-full: 999px; /* ステッカーバッジ・スタンプ数字 */

  /* 紙が浮く影。ぼかし弱め・Y方向強めで「貼った」感 */
  --shadow-sticker:  0 2px 0 rgba(27, 27, 58, .18);
  --shadow-card:     0 6px 16px rgba(27, 27, 58, .10);
  --shadow-polaroid: 2px 6px 14px rgba(27, 27, 58, .16);
  --shadow-cta:      0 5px 0 var(--color-cta-shadow);
  --shadow-cta-hover: 0 2px 0 var(--color-cta-shadow);

  /* アニメーション基準値 */
  --ease-out: cubic-bezier(.16, 1, .3, 1);
  --dur-reveal: .5s;
  --dur-stamp: .25s;
}

/* -------------------------------------------------------------------------
   0. ベース
   ------------------------------------------------------------------------- */
* { box-sizing: border-box; }

body {
  background: var(--color-cream);
  color: var(--color-ink);
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.9;
  -webkit-font-smoothing: antialiased;
}

img { max-width: 100%; display: block; }

/* -------------------------------------------------------------------------
   コンテナ
   ------------------------------------------------------------------------- */
.container {
  width: min(1120px, 92%);
  margin-inline: auto;
}

.container--narrow {
  width: min(760px, 92%);
  margin-inline: auto;
}

.section {
  padding-block: var(--sp-6);
  position: relative;
  overflow: hidden; /* 紙吹雪・地紋・斜め帯のはみ出しを内包 */
}

@media (max-width: 640px) {
  .section { padding-block: var(--sp-5); }
}

/* 地紋(方眼 / ドット)。背景に敷くだけの装飾レイヤー */
.bg-grid {
  background-image:
    linear-gradient(var(--color-ink-grid) 1px, transparent 1px),
    linear-gradient(90deg, var(--color-ink-grid) 1px, transparent 1px);
  background-size: 28px 28px;
}

.bg-dots {
  background-image: radial-gradient(var(--color-ink-grid) 2px, transparent 2px);
  background-size: 20px 20px;
}

/* -------------------------------------------------------------------------
   セクション見出しスタイル
   ------------------------------------------------------------------------- */
.section-heading {
  text-align: center;
  margin-bottom: var(--sp-4);
}

.section-heading__eyebrow {
  display: inline-block;
  font-family: var(--font-en);
  font-weight: 800;
  font-size: 14px;
  letter-spacing: .15em;
  text-transform: uppercase;
  color: var(--color-orange);
  margin-bottom: var(--sp-1);
}

.section-heading__title {
  font-family: var(--font-heading);
  font-weight: 900;
  font-size: clamp(28px, 5vw, 48px);
  letter-spacing: .04em;
  line-height: 1.3;
  color: var(--color-ink);
  margin: 0;
}

.section-heading__lead {
  font-family: var(--font-body);
  font-size: 16px;
  color: var(--color-ink);
  opacity: .8;
  margin-top: var(--sp-2);
}

/* 濃色背景(--color-ink等)上に置く場合 */
.section-heading--on-dark .section-heading__title,
.section-heading--on-dark .section-heading__lead { color: var(--color-cream); opacity: 1; }
.section-heading--on-dark .section-heading__eyebrow { color: var(--color-yellow); }

/* 蛍光マーカー下線(見出し・強調語向けインライン装飾) */
.marker {
  background-image: linear-gradient(transparent 55%, var(--color-yellow-marker) 55%);
  padding: 0 .05em;
}

/* -------------------------------------------------------------------------
   ボタン(チケット半券CTA)
   ------------------------------------------------------------------------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-1);
  font-family: var(--font-heading);
  font-weight: 800;
  font-size: 16px;
  letter-spacing: .02em;
  border: none;
  cursor: pointer;
  text-decoration: none;
  border-radius: var(--r-lg);
  padding: var(--sp-2) var(--sp-3);
  transition: transform .15s ease, box-shadow .15s ease;
}

/* メインCTA: チケット半券風。--notch-bg は設置するセクション背景色に合わせて上書きする
   例) 濃紺(--color-ink)背景の上に置く場合: style="--notch-bg:var(--color-ink)" */
.btn--cta {
  position: relative;
  background: var(--color-orange);
  color: var(--color-cream);
  box-shadow: var(--shadow-cta);
  padding: var(--sp-2) var(--sp-4);
  --notch-bg: var(--color-cream);
  --notch-size: 18px;
}

.btn--cta::before,
.btn--cta::after {
  content: "";
  position: absolute;
  top: 50%;
  width: var(--notch-size);
  height: var(--notch-size);
  background: var(--notch-bg);
  border-radius: 50%;
  transform: translateY(-50%);
}
.btn--cta::before { left: calc(var(--notch-size) / -2); }
.btn--cta::after  { right: calc(var(--notch-size) / -2); }

.btn--cta:hover,
.btn--cta:focus-visible {
  transform: translateY(3px);
  box-shadow: var(--shadow-cta-hover);
}

/* ヘッダー用ミニCTA(チケット感は簡略) */
.btn--mini {
  background: var(--color-orange);
  color: var(--color-cream);
  font-size: 14px;
  padding: 10px var(--sp-2);
  box-shadow: var(--shadow-sticker);
}
.btn--mini:hover { transform: translateY(2px); box-shadow: 0 0 0 rgba(0,0,0,0); }

/* アウトライン(サブ導線) */
.btn--outline {
  background: transparent;
  color: var(--color-ink);
  border: 3px solid var(--color-ink);
  padding: calc(var(--sp-2) - 3px) calc(var(--sp-3) - 3px);
}

/* -------------------------------------------------------------------------
   バッジ(ステッカー・値札POP)
   ------------------------------------------------------------------------- */
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 15px;
  line-height: 1.3;
  text-align: center;
  background: var(--color-yellow);
  color: var(--color-ink);
  border: 3px solid var(--color-paper);
  box-shadow: var(--shadow-sticker);
  border-radius: var(--r-full);
  padding: var(--sp-1) var(--sp-3);
  transform: rotate(-6deg);
  white-space: nowrap;
}

.badge--teal  { background: var(--color-teal); color: var(--color-paper); }
.badge--orange{ background: var(--color-orange); color: var(--color-cream); }

/* 円形スタンプ数字(部屋番号・時刻・ステップ数字) */
.badge--stamp {
  border-radius: var(--r-full);
  width: 56px;
  height: 56px;
  padding: 0;
  font-size: 18px;
  border-width: 2px;
  transform: rotate(0deg);
}

/* 値札POP(黄味クリーム短冊+極太数字+ギザ上辺) */
.price-pop {
  position: relative;
  display: inline-block;
  background: var(--color-yellow-soft);
  color: var(--color-ink);
  font-family: var(--font-display);
  padding: var(--sp-2) var(--sp-3) var(--sp-1);
  border-radius: 0 0 var(--r-sm) var(--r-sm);
  box-shadow: var(--shadow-sticker);
  clip-path: polygon(
    0% 12px, 6% 0%, 12% 12px, 18% 0%, 24% 12px, 30% 0%, 36% 12px, 42% 0%,
    48% 12px, 54% 0%, 60% 12px, 66% 0%, 72% 12px, 78% 0%, 84% 12px, 90% 0%,
    96% 12px, 100% 0%, 100% 100%, 0% 100%
  );
}

/* 回転ユーティリティ(バッジ・写真の「貼った」感の振り分けに使用) */
.rotate-n6 { transform: rotate(-6deg) !important; }
.rotate-n4 { transform: rotate(-4deg) !important; }
.rotate-n2 { transform: rotate(-2deg) !important; }
.rotate-2  { transform: rotate(2deg)  !important; }
.rotate-4  { transform: rotate(4deg)  !important; }
.rotate-6  { transform: rotate(6deg)  !important; }

/* -------------------------------------------------------------------------
   カード
   ------------------------------------------------------------------------- */
.card {
  background: var(--color-paper);
  border-radius: var(--r-md);
  box-shadow: var(--shadow-card);
  padding: var(--sp-3);
}

/* 数字タイル(s04 「数字で見るHQ」) */
.card--tile {
  text-align: center;
}
.card--tile .card__number {
  font-family: var(--font-display);
  font-size: clamp(32px, 5vw, 44px);
  color: var(--color-orange);
  display: block;
}
.card--tile .card__label {
  font-family: var(--font-body);
  font-weight: 700;
  font-size: 14px;
  margin-top: var(--sp-1);
}

/* チケット型カード(s09 お部屋一覧): 破線ミシン目で半券風に区切る */
.card--ticket {
  position: relative;
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: var(--sp-2);
}
.card--ticket::after {
  content: "";
  position: absolute;
  top: var(--sp-2);
  bottom: var(--sp-2);
  right: 108px;
  border-left: 2px dashed var(--color-ink-grid);
}

/* -------------------------------------------------------------------------
   写真フレーム(ポラロイド + マスキングテープ)
   ------------------------------------------------------------------------- */
.photo-frame {
  display: inline-block;
  position: relative;
  background: var(--color-paper);
  padding: 10px 10px 44px;
  box-shadow: var(--shadow-polaroid);
  border-radius: 2px;
  max-width: 100%;
}

.photo-frame img {
  width: 100%;
  aspect-ratio: 16 / 10;
  object-fit: cover;
  border-radius: 1px;
}

.photo-frame__caption {
  position: absolute;
  left: 10px;
  right: 10px;
  bottom: 10px;
  margin: 0; /* pのUAデフォルトマージンで写真に食い込むのを防ぐ */
  text-align: center;
  font-family: var(--font-hand);
  font-size: 14px;
  color: var(--color-ink);
}

/* 大判写真(共用部・屋上ツアー用) */
.photo-frame--lg { width: min(560px, 100%); }

/* マスキングテープ: 写真の角に ±8° で重ねる */
.washi-tape {
  position: absolute;
  width: 72px;
  height: 26px;
  top: -14px;
  left: 50%;
  opacity: .85;
  transform: translateX(-50%) rotate(-6deg);
}
.washi-tape--corner-left  { left: 18px; transform: rotate(-8deg); }
.washi-tape--corner-right { left: auto; right: 18px; transform: rotate(8deg); }

.washi-tape--teal   { background: var(--color-teal); }
.washi-tape--cream  { background: var(--color-cream); border: 1px solid var(--color-ink-grid); }
.washi-tape--orange {
  background-color: rgba(255, 107, 53, .25);
  background-image: repeating-linear-gradient(45deg, var(--color-orange) 0 6px, transparent 6px 12px);
}

/* -------------------------------------------------------------------------
   斜めセクション区切り + マーキー帯
   ------------------------------------------------------------------------- */
/* -3° の斜め帯。中身(.marquee-band__inner等)は回転させず可読性を保つ実装:
   親要素をoverflow:hiddenにし、擬似要素だけ回転させた帯を敷く。
   使用例:
   <div class="section-diagonal">
     <div class="section-diagonal__inner">
       <div class="marquee-band"><div class="marquee-band__track">...文言 ★ 文言 ★...</div></div>
     </div>
   </div>
*/
.section-diagonal {
  position: relative;
  overflow: hidden;
  padding-block: var(--sp-2);
}
.section-diagonal::before {
  content: "";
  position: absolute;
  inset: -30% -8%;
  background: var(--color-orange);
  transform: rotate(-3deg);
  z-index: 0;
}
.section-diagonal--reverse::before { transform: rotate(3deg); }
.section-diagonal--teal::before { background: var(--color-teal); }
.section-diagonal--ink::before { background: var(--color-ink); }

.section-diagonal__inner {
  position: relative;
  z-index: 1;
}

/* マーキー帯(無限スクロールのフェスコピー) */
.marquee-band {
  overflow: hidden;
  width: 100%;
}
.marquee-band__track {
  display: flex;
  width: max-content;
  gap: var(--sp-4);
  white-space: nowrap;
  font-family: var(--font-en);
  font-weight: 800;
  letter-spacing: .08em;
  color: var(--color-cream);
  animation: marquee-scroll 40s linear infinite;
}
@keyframes marquee-scroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

/* -------------------------------------------------------------------------
   reveal用アニメーションクラス(IntersectionObserverで.is-visibleを付与)
   ------------------------------------------------------------------------- */
/* 通常のスクロールイン(本文・写真・カード全般) */
.reveal {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity var(--dur-reveal) var(--ease-out),
              transform var(--dur-reveal) var(--ease-out);
}
.reveal.is-visible {
  opacity: 1;
  transform: translateY(0);
}

/* ぺたぺたスタンプ演出(バッジ・ポラロイド・値札POP用。.reveal とは別要素に付与すること) */
.stamp-in {
  opacity: 0;
}
.stamp-in.is-visible {
  animation: stamp-pop var(--dur-stamp) var(--ease-out) forwards;
}
@keyframes stamp-pop {
  from { opacity: 0; transform: scale(1.12) rotate(var(--stamp-rot, 0deg)); }
  to   { opacity: 1; transform: scale(1)    rotate(var(--stamp-rot, 0deg)); }
}

/* 同グループ内 stagger(最大5要素、0.1s刻み) */
.reveal-delay-1, .stamp-delay-1 { transition-delay: .1s; animation-delay: .1s; }
.reveal-delay-2, .stamp-delay-2 { transition-delay: .2s; animation-delay: .2s; }
.reveal-delay-3, .stamp-delay-3 { transition-delay: .3s; animation-delay: .3s; }
.reveal-delay-4, .stamp-delay-4 { transition-delay: .4s; animation-delay: .4s; }
.reveal-delay-5, .stamp-delay-5 { transition-delay: .5s; animation-delay: .5s; }

/* 配慮: 動きを抑えたい環境ではtransform系を無効化しopacityのみに */
@media (prefers-reduced-motion: reduce) {
  .reveal,
  .stamp-in.is-visible {
    transition: opacity var(--dur-reveal) linear;
    animation: none;
    transform: none;
  }
  .marquee-band__track { animation: none; }
}

/* ================= section 01 ================= */
/* ==== s01 ヘッダー + ヒーロー ==== */
  .s01-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-cream);
    border-bottom: 3px solid var(--color-ink);
  }
  .s01-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    padding-block: 10px;
  }
  .s01-brand {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    text-decoration: none;
    color: var(--color-ink);
  }
  .s01-brand img { height: 36px; width: auto; display: block; }
  .s01-brand span {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 15px;
    letter-spacing: .06em;
    white-space: nowrap;
  }
  .s01-nav { display: flex; align-items: center; gap: var(--sp-3); }
  .s01-nav__links { display: flex; gap: var(--sp-3); list-style: none; margin: 0; padding: 0; }
  .s01-nav__links a {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 14px;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  .s01-nav__links a:hover { border-color: var(--color-orange); }
  .s01-burger {
    display: none;
    width: 40px; height: 40px;
    border-radius: var(--r-sm);
    background: var(--color-cream);
    border: 2px solid var(--color-ink);
    position: relative;
    cursor: pointer;
  }
  .s01-burger span, .s01-burger span::before, .s01-burger span::after {
    content: ""; position: absolute; left: 8px; right: 8px; height: 2px; background: var(--color-ink);
  }
  .s01-burger span { top: 19px; }
  .s01-burger span::before { top: -7px; }
  .s01-burger span::after { top: 7px; }
  @media (max-width: 800px) {
    .s01-nav__links { display: none; }
    .s01-burger { display: block; }
    .s01-brand span { font-size: 13px; }
  }
  /* SPは下部固定CTAバーがあるため、ヘッダー内ミニCTAは非表示(潰れ防止) */
  @media (max-width: 640px) {
    .s01-header .btn--mini { display: none; }
  }

  /* ==== ヒーロー本体 ==== */
  .s01-hero {
    position: relative;
    background: var(--color-cream);
    padding-top: var(--sp-6);
    padding-bottom: 0;
  }
  .s01-hero__confetti {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .s01-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    grid-template-areas:
      "head photo"
      "rest photo";
    column-gap: var(--sp-5);
    align-items: center;
  }
  .s01-copy-head { grid-area: head; align-self: end; }
  .s01-copy-rest { grid-area: rest; align-self: start; }
  .s01-photo-stage { grid-area: photo; }
  /* モバイル: 見出し→写真→CTAの順で、1画面目に写真が入るようにする */
  @media (max-width: 900px) {
    .s01-hero__grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        "head"
        "photo"
        "rest";
      row-gap: var(--sp-3);
    }
    .s01-photo-stage {
      width: min(330px, 86%);
      padding-bottom: 6px;
    }
    .s01-photo-stage .photo-frame { transform: rotate(-2deg); }
  }
  .s01-eyebrow {
    font-family: var(--font-en);
    font-weight: 800;
    font-size: 14px;
    letter-spacing: .2em;
    color: var(--color-orange);
    margin-bottom: var(--sp-2);
  }
  .s01-title {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(34px, 5.6vw, 58px);
    line-height: 1.35;
    letter-spacing: .03em;
    color: var(--color-ink);
    margin: 0 0 var(--sp-3);
  }
  .s01-marker-wrap { position: relative; display: inline-block; padding: 0 2px; }
  .s01-marker-wrap svg { position: absolute; left: 0; bottom: 2px; width: 100%; height: 55%; z-index: -1; }
  .s01-circle-wrap { position: relative; display: inline-block; padding: 2px 14px; }
  .s01-circle-wrap svg { position: absolute; inset: -10px -6px; width: calc(100% + 20px); height: calc(100% + 26px); z-index: -1; }
  .s01-sub {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.9;
    color: var(--color-ink);
    max-width: 46ch;
    margin-bottom: var(--sp-4);
  }
  .s01-cta-row { display: flex; align-items: center; gap: var(--sp-3); flex-wrap: wrap; }
  .s01-micro {
    font-family: var(--font-hand);
    font-size: 14px;
    color: var(--color-ink);
    margin-top: var(--sp-2);
  }

  /* ==== 写真+バッジ群 ==== */
  .s01-photo-stage {
    position: relative;
    width: min(460px, 100%);
    margin-inline: auto;
    padding-bottom: var(--sp-4);
  }
  .s01-photo-stage .photo-frame {
    transform: rotate(-3deg);
    width: 100%;
  }
  /* ヒーローはトリミングせず写真全体(4:3)を見せる */
  .s01-photo-stage .photo-frame img {
    aspect-ratio: auto;
    object-fit: contain;
  }
  .s01-badge-pos {
    position: absolute;
    z-index: 3;
  }
  .s01-badge-pos--1 { top: -22px; left: -28px; }
  .s01-badge-pos--2 { top: 40%; right: -40px; }
  .s01-badge-pos--3 { bottom: 8px; left: -20px; }
  @media (max-width: 500px) {
    .s01-badge-pos--1 { top: -16px; left: -10px; }
    .s01-badge-pos--2 { right: -12px; }
    .s01-badge-pos--3 { left: -8px; }
  }
  .s01-sticker-svg text { font-family: 'Mochiy Pop One', sans-serif; }

  /* ==== 下端マーキー(斜め帯) ==== */
  .s01-marquee-zone {
    position: relative;
    margin-top: var(--sp-5);
  }
  .s01-marquee-zone .section-diagonal { padding-block: 18px; }
  .s01-marquee-zone .marquee-band__track { font-size: 15px; }

/* ================= section 02 ================= */
/* ==== s02 共感導入(濃紺の夜) ==== */
  .s02-section {
    background: var(--color-ink);
    position: relative;
    color: var(--color-cream);
    padding-bottom: 0;
  }
  .s02-stars {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .s02-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-5);
    align-items: start;
  }
  @media (max-width: 880px) {
    .s02-grid { grid-template-columns: 1fr; }
  }
  .s02-lead {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(24px, 3.6vw, 34px);
    line-height: 1.7;
    color: var(--color-cream);
    margin: 0;
  }
  .s02-lead em {
    display: block;
    font-style: normal;
    color: var(--color-yellow);
  }
  .s02-body {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.95;
    color: var(--color-cream);
    opacity: .92;
  }
  .s02-body p { margin: 0 0 var(--sp-2); }
  /* 吹き出しはCSSボックス化: テキスト量に応じて伸びるので折り返し崩れが起きない */
  .s02-bubble-wrap {
    position: relative;
    width: min(420px, 100%);
    margin-top: var(--sp-3);
    margin-bottom: 26px;
    background: #FFFDF8;
    border: 3px solid #2EC4B6;
    border-radius: 16px;
    padding: 18px 22px;
  }
  .s02-bubble-wrap::before,
  .s02-bubble-wrap::after {
    content: '';
    position: absolute;
    left: 64px;
    width: 0; height: 0;
    border-style: solid;
  }
  .s02-bubble-wrap::before {
    bottom: -24px;
    border-width: 24px 12px 0 12px;
    border-color: #2EC4B6 transparent transparent transparent;
  }
  .s02-bubble-wrap::after {
    bottom: -18px;
    left: 67px;
    border-width: 19px 9px 0 9px;
    border-color: #FFFDF8 transparent transparent transparent;
  }
  .s02-bubble-text {
    margin: 0;
    text-align: center;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 15px;
    color: var(--color-ink);
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  .s02-annot {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-1);
    margin-top: var(--sp-3);
  }
  .s02-annot svg { flex: none; margin-top: -6px; }
  .s02-annot span {
    font-family: var(--font-hand);
    font-size: 14px;
    color: var(--color-yellow);
  }

  /* ==== 明転への繋ぎ(オレンジ斜め帯) ==== */
  .s02-turn {
    position: relative;
    margin-top: var(--sp-5);
  }
  .s02-turn .section-diagonal { padding-block: 22px; }
  .s02-turn__text {
    position: relative;
    z-index: 1;
    text-align: center;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(18px, 2.6vw, 24px);
    color: var(--color-cream);
    letter-spacing: .06em;
  }

/* ================= section 03 ================= */
/* ==== s03 コンセプトストーリー ==== */
  .s03-section {
    background: var(--color-cream);
  }
  .s03-layout {
    display: grid;
    grid-template-columns: 1fr .34fr;
    gap: var(--sp-5);
    align-items: start;
  }
  @media (max-width: 860px) {
    .s03-layout { grid-template-columns: 1fr; }
  }
  .s03-heading {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(28px, 4.6vw, 44px);
    line-height: 1.5;
    letter-spacing: .03em;
    color: var(--color-ink);
    margin: 0 0 var(--sp-3);
  }
  .s03-marker-wrap { position: relative; display: inline-block; padding: 0 2px; }
  .s03-marker-wrap svg { position: absolute; left: 0; bottom: 0; width: 100%; height: 60%; z-index: -1; }
  .s03-lead {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 18px;
    color: var(--color-orange);
    margin-bottom: var(--sp-3);
  }
  .s03-body {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.95;
    color: var(--color-ink);
    max-width: 62ch;
  }
  .s03-body p { margin: 0 0 var(--sp-3); }

  /* ==== 右側: ロゴ+手書き注釈カード ==== */
  .s03-aside {
    background: var(--color-paper);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-card);
    padding: var(--sp-3);
    transform: rotate(2deg);
    text-align: center;
  }
  .s03-aside img {
    width: 120px;
    margin-inline: auto;
    margin-bottom: var(--sp-2);
  }
  .s03-annot {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-1);
    justify-content: center;
    text-align: left;
  }
  .s03-annot svg { flex: none; transform: rotate(30deg); margin-top: 2px; }
  .s03-annot span {
    font-family: var(--font-hand);
    font-size: 14px;
    color: var(--color-ink);
    line-height: 1.6;
  }
  .s03-aside__tagline {
    margin-top: var(--sp-2);
    font-family: var(--font-en);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: .12em;
    color: var(--color-teal);
  }

/* ================= section 04 ================= */
/* ==== s04 数字で見るHQ ==== */
  .s04-section {
    background: var(--color-teal-soft);
    position: relative;
  }
  .s04-corner-dots {
    position: absolute;
    top: 0; right: 0;
    width: 220px; height: 220px;
    opacity: .5;
    pointer-events: none;
    z-index: 0;
  }
  .s04-tiles {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sp-3);
  }
  @media (max-width: 880px) {
    .s04-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 480px) {
    .s04-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-2); }
  }
  .s04-tile { position: relative; min-width: 0; }
  /* PCは4×2のきれいなグリッド。2カラム時のみ横長タイルを全幅に */
  @media (max-width: 880px) {
    .s04-tile--span2 { grid-column: span 2; }
  }
  @media (max-width: 480px) {
    .s04-tile--price, .s04-tile--full-sp { grid-column: span 2; }
    .s04-tiles .card { padding: var(--sp-2) 12px; }
    .card--tile .card__number { font-size: 26px; }
    .s04-tile--price .price-pop { font-size: 26px; }
    .s04-stamp-corner { right: -4px; }
  }
  .s04-tile .card--tile { height: 100%; }

  /* 値札POP専用タイル */
  .s04-tile--price .price-pop {
    display: block;
    font-size: clamp(24px, 2.4vw, 34px);
    padding-inline: var(--sp-1);
    text-align: center;
    white-space: nowrap;
  }
  .s04-tile--price .card__label {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 13px;
    margin-top: var(--sp-2);
    text-align: center;
  }

  /* 手書き丸囲みタイル(5万円) */
  .s04-circle-wrap { position: relative; display: inline-block; padding: 2px 10px; }
  .s04-circle-wrap svg { position: absolute; inset: -8px -4px; width: calc(100% + 16px); height: calc(100% + 22px); z-index: -1; }

  /* スタンプ風アクセント(全10室タイル角に添える) */
  .s04-stamp-corner { position: absolute; top: -14px; right: -10px; z-index: 2; }

  .s04-note {
    margin-top: var(--sp-4);
    text-align: center;
  }
  .s04-note__main {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--color-ink);
  }
  .s04-note__hand {
    font-family: var(--font-hand);
    font-size: 14px;
    color: var(--color-orange);
    margin-top: var(--sp-1);
  }

/* ================= section 05 ================= */
/* ==== s05 HQ TIME TABLE(フェスタイムテーブル風1日) ==== */
  .s05-turn {
    position: relative;
  }
  .s05-turn .section-diagonal { padding-block: 18px; }
  .s05-turn .marquee-band__track { font-size: 15px; }

  .s05-section {
    background: var(--color-orange);
    color: var(--color-cream);
    position: relative;
  }
  .s05-confetti {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .s05-heading {
    position: relative;
    z-index: 1;
  }
  .s05-heading .section-heading__title { font-size: clamp(30px, 5vw, 52px); }

  .s05-timeline {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: var(--sp-5) auto 0;
    padding-left: 68px;
    list-style: none;
  }
  .s05-timeline::before {
    content: "";
    position: absolute;
    left: 27px;
    top: 6px;
    bottom: 6px;
    width: 3px;
    background: var(--color-cream);
    opacity: .5;
    border-radius: 2px;
  }
  .s05-item {
    position: relative;
    padding-bottom: var(--sp-5);
  }
  .s05-item:last-child { padding-bottom: 0; }
  .s05-item:nth-child(even) .s05-item__inner { margin-left: var(--sp-3); }
  .s05-item:nth-child(odd) .s05-item__inner { margin-left: 0; }

  .s05-stamp {
    position: absolute;
    left: -68px;
    top: -6px;
    background: var(--color-yellow);
    color: var(--color-ink);
    border-color: var(--color-cream);
    font-size: 11px;
    line-height: 1.1;
    width: 54px;
    height: 54px;
  }
  .s05-item:nth-child(3n+2) .s05-stamp { transform: rotate(-6deg); }
  .s05-item:nth-child(3n) .s05-stamp { transform: rotate(5deg); }

  .s05-item__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(19px, 2.6vw, 24px);
    color: var(--color-cream);
    margin: 0 0 6px;
  }
  .s05-item__text {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 15.5px;
    line-height: 1.85;
    color: var(--color-cream);
    max-width: 46ch;
    margin: 0;
  }

  /* 吹き出し(paper地+teal縁、実テキストはHTMLで重ねる) */
  .s05-bubble {
    position: relative;
    width: min(300px, 88vw);
    margin-top: var(--sp-2);
  }
  .s05-bubble svg { width: 100%; height: auto; display: block; }
  .s05-bubble__text {
    position: absolute;
    inset: 12px 16px 34px 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--color-ink);
  }

  /* 手書き注釈(矢印+Zen Kurenaido) */
  .s05-annot {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-1);
    margin-top: var(--sp-2);
  }
  .s05-annot svg { flex: none; margin-top: -4px; }
  .s05-annot span {
    font-family: var(--font-hand);
    font-size: 14px;
    color: var(--color-ink);
  }

  .s05-closing {
    position: relative;
    z-index: 1;
    text-align: center;
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(20px, 3vw, 28px);
    color: var(--color-cream);
    margin-top: var(--sp-6);
    letter-spacing: .02em;
  }

  /* PC広幅時のみ: タイムテーブル右の余白にポラロイドを散らして密度を出す */
  .s05-photos {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    display: none;
  }
  @media (min-width: 1200px) {
    .s05-photos { display: block; }
  }
  .s05-photos .photo-frame { position: absolute; }
  .s05-photo--1 { width: 250px; right: 7%; top: 330px; transform: rotate(4deg); }
  .s05-photo--2 { width: 230px; right: 12%; top: 780px; transform: rotate(-5deg); }
  .s05-photo--3 { width: 250px; right: 6%; top: 1230px; transform: rotate(3deg); }
  .s05-photo--4 { width: 235px; right: 11%; top: 1650px; transform: rotate(-4deg); }

  @media (max-width: 560px) {
    .s05-timeline { padding-left: 56px; }
    .s05-stamp { left: -56px; width: 46px; height: 46px; font-size: 10px; }
    .s05-item:nth-child(even) .s05-item__inner { margin-left: 0; }
  }

/* ================= section 06 ================= */
/* ==== s06 共用部ツアー ==== */
  .s06-section {
    background: var(--color-cream);
    position: relative;
  }
  .s06-corner-dots {
    position: absolute;
    top: 0; left: 0;
    width: 240px; height: 240px;
    opacity: .6;
    pointer-events: none;
    z-index: 0;
  }
  .s06-heading { position: relative; z-index: 1; }

  .s06-row {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: .92fr 1fr;
    gap: var(--sp-5);
    align-items: center;
    margin-bottom: var(--sp-5);
  }
  .s06-row--reverse { grid-template-columns: 1fr .92fr; }
  .s06-row--reverse .s06-photos { order: 2; }
  .s06-row--reverse .s06-copy { order: 1; }
  @media (max-width: 860px) {
    .s06-row, .s06-row--reverse { grid-template-columns: 1fr; }
    .s06-row--reverse .s06-photos,
    .s06-row--reverse .s06-copy { order: initial; }
  }

  .s06-photos {
    position: relative;
    min-height: 220px;
  }
  .s06-photos .photo-frame--primary {
    width: min(360px, 88%);
    position: relative;
    z-index: 2;
  }
  .s06-photos .photo-frame--secondary {
    width: min(220px, 60%);
    position: absolute;
    z-index: 1;
  }
  .s06-photos--a .photo-frame--primary { transform: rotate(-4deg); }
  .s06-photos--a .photo-frame--secondary { right: -8px; bottom: -28px; transform: rotate(6deg); }
  .s06-photos--b .photo-frame--primary { transform: rotate(3deg); margin-left: auto; }
  .s06-photos--b .photo-frame--secondary { left: -8px; bottom: -24px; transform: rotate(-7deg); }
  .s06-photos--single .photo-frame { width: min(420px, 92%); transform: rotate(-2deg); }
  .s06-photos--c .photo-frame--primary { transform: rotate(-3deg); }
  .s06-photos--c .photo-frame--secondary { right: -12px; bottom: -44px; transform: rotate(7deg); }

  .s06-copy__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(20px, 2.8vw, 26px);
    color: var(--color-ink);
    margin: 0 0 var(--sp-2);
  }
  .s06-copy__body {
    font-family: var(--font-body);
    font-size: 15.5px;
    line-height: 1.9;
    color: var(--color-ink);
    max-width: 46ch;
  }
  .s06-annot {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-1);
    margin-top: var(--sp-2);
  }
  .s06-annot svg { flex: none; margin-top: -4px; }
  .s06-annot span {
    font-family: var(--font-hand);
    font-size: 14px;
    color: var(--color-orange);
  }

  .s06-divider { width: 100%; margin: var(--sp-4) 0; line-height: 0; position: relative; z-index: 1; }
  .s06-divider svg { display: block; width: 100%; height: 30px; }

/* ================= section 07 ================= */
/* ==== s07 キッチン家電ワンダーランド ==== */
  .s07-section {
    background: var(--color-yellow);
    position: relative;
  }
  .s07-bunting {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 34px;
    opacity: .5;
    pointer-events: none;
    z-index: 0;
  }
  .s07-heading { position: relative; z-index: 1; }
  .s07-heading .section-heading__lead { opacity: .85; }

  .s07-layout {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--sp-5);
    align-items: start;
  }
  @media (max-width: 900px) {
    .s07-layout { grid-template-columns: 1fr; }
  }

  .s07-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-3) var(--sp-2);
  }
  @media (max-width: 640px) {
    .s07-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .s07-tag {
    position: relative;
    background: var(--color-paper);
    color: var(--color-ink);
    padding: var(--sp-2) var(--sp-2) var(--sp-2);
    box-shadow: var(--shadow-sticker);
    clip-path: polygon(0 0, 100% 0, 100% 82%, 92% 100%, 8% 100%, 0 82%);
    font-family: var(--font-body);
  }
  .s07-tag__name {
    display: block;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 14.5px;
    margin-bottom: 4px;
    line-height: 1.35;
  }
  .s07-tag__desc {
    display: block;
    font-size: 13px;
    line-height: 1.6;
    opacity: .85;
  }
  .s07-tag:nth-child(3n+1) { transform: rotate(-3deg); }
  .s07-tag:nth-child(3n+2) { transform: rotate(2deg); }
  .s07-tag:nth-child(3n)   { transform: rotate(-2deg); }

  .s07-aside { position: relative; }
  .s07-aside .photo-frame {
    width: min(340px, 100%);
    transform: rotate(3deg);
    margin-inline: auto;
  }
  .s07-bubble {
    position: relative;
    width: min(280px, 88%);
    margin: var(--sp-3) auto 22px;
    background: #FFF6E9;
    border: 3px solid var(--color-ink);
    border-radius: 16px;
    padding: 14px 18px;
  }
  .s07-bubble::before,
  .s07-bubble::after {
    content: '';
    position: absolute;
    left: 52px;
    width: 0; height: 0;
    border-style: solid;
  }
  .s07-bubble::before {
    bottom: -22px;
    border-width: 22px 11px 0 11px;
    border-color: var(--color-ink) transparent transparent transparent;
  }
  .s07-bubble::after {
    bottom: -16px;
    left: 55px;
    border-width: 17px 8px 0 8px;
    border-color: #FFF6E9 transparent transparent transparent;
  }
  .s07-bubble__text {
    margin: 0;
    text-align: center;
    font-family: var(--font-hand);
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }

  .s07-annot {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-1);
    justify-content: center;
    margin-top: var(--sp-3);
  }
  .s07-annot svg { flex: none; }
  .s07-annot span {
    font-family: var(--font-hand);
    font-size: 14px;
    color: var(--color-ink);
  }

  .s07-closing {
    position: relative;
    z-index: 1;
    text-align: center;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(18px, 2.8vw, 24px);
    color: var(--color-ink);
    margin-top: var(--sp-5);
  }

/* ================= section 08 ================= */
/* ==== s08 屋上ライフ ==== */
  .s08-turn { position: relative; }
  .s08-turn .section-diagonal { padding-block: 18px; }
  .s08-turn .marquee-band__track { font-size: 15px; }

  .s08-section {
    background: var(--color-ink);
    color: var(--color-cream);
    position: relative;
  }
  .s08-stars {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .s08-content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: .9fr 1.1fr;
    gap: var(--sp-5);
    align-items: center;
  }
  @media (max-width: 900px) {
    .s08-content { grid-template-columns: 1fr; }
  }

  .s08-eyebrow {
    font-family: var(--font-en);
    font-weight: 900;
    font-size: clamp(38px, 6vw, 68px);
    letter-spacing: .1em;
    color: var(--color-teal);
    line-height: 1;
    margin: 0 0 var(--sp-2);
  }
  .s08-title {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(26px, 4vw, 40px);
    letter-spacing: .03em;
    color: var(--color-cream);
    margin: 0 0 var(--sp-3);
  }
  .s08-lead {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 16px;
    line-height: 1.9;
    color: var(--color-cream);
    opacity: .95;
    margin: 0 0 var(--sp-3);
    max-width: 42ch;
  }
  .s08-body {
    font-family: var(--font-body);
    font-size: 15.5px;
    line-height: 1.9;
    color: var(--color-cream);
    opacity: .88;
    max-width: 42ch;
  }

  .s08-bubble {
    position: relative;
    width: min(260px, 90%);
    margin-top: var(--sp-3);
  }
  .s08-bubble svg { width: 100%; height: auto; display: block; }
  .s08-bubble__text {
    position: absolute;
    inset: 12px 16px 34px 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 15px;
    color: var(--color-ink);
  }

  .s08-annot {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-1);
    margin-top: var(--sp-3);
  }
  .s08-annot svg { flex: none; margin-top: -4px; }
  .s08-annot span {
    font-family: var(--font-hand);
    font-size: 14px;
    color: var(--color-yellow);
  }

  /* フォトウォール(ランダム回転コラージュ) */
  .s08-wall {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    justify-content: center;
    padding: var(--sp-2);
  }
  .s08-wall .photo-frame { width: min(230px, 44%); }
  .s08-wall .photo-frame:nth-child(1) { transform: rotate(-5deg) translateY(6px); }
  .s08-wall .photo-frame:nth-child(2) { transform: rotate(4deg) translateY(-10px); }
  .s08-wall .photo-frame:nth-child(3) { transform: rotate(-3deg) translateY(18px); }
  .s08-wall .photo-frame:nth-child(4) { transform: rotate(5deg) translateY(-4px); }
  @media (max-width: 560px) {
    .s08-wall .photo-frame { width: min(230px, 68%); }
  }

/* ================= section 09 ================= */
/* ==== s09 お部屋紹介+全10室料金表 ==== */
  .s09-section {
    background: var(--color-cream);
    position: relative;
  }

  .s09-head-badge {
    position: absolute;
    top: 12px;
    right: 6%;
    z-index: 2;
  }
  @media (max-width: 640px) {
    .s09-head-badge { top: 0; right: 8px; }
    .s09-head-badge svg { width: 64px; }
    /* 見出しがバッジと重ならないよう、モバイルでは見出しを下げる */
    .s09-section .section-heading { padding-top: 40px; }
  }

  /* 波形区切り(deco 01を再配色: ink) */
  .s09-divider { display: block; margin: 0 auto var(--sp-4); width: min(360px, 70%); opacity: .5; }

  .s09-micro {
    text-align: center;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 14px;
    max-width: 56ch;
    margin: 0 auto var(--sp-4);
    color: var(--color-ink);
  }

  .s09-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-4) var(--sp-3);
  }
  @media (max-width: 860px) {
    .s09-grid { grid-template-columns: 1fr; gap: var(--sp-3); }
  }

  .s09-ticket {
    position: relative;
    background: var(--color-paper);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-card);
    padding: var(--sp-3) var(--sp-2) var(--sp-3) var(--sp-3);
    display: grid;
    grid-template-columns: 60px 1fr auto;
    align-items: center;
    gap: var(--sp-2);
    overflow: visible;
  }
  .s09-ticket::before {
    /* ミシン目(半券区切り) */
    content: "";
    position: absolute;
    top: 14px;
    bottom: 14px;
    right: 96px;
    border-left: 2px dashed var(--color-ink-grid);
  }
  @media (max-width: 420px) {
    .s09-ticket { grid-template-columns: 48px 1fr auto; padding-right: var(--sp-2); }
    .s09-ticket::before { right: 76px; }
  }

  .s09-ticket__stamp {
    width: 56px;
    height: 56px;
    font-size: 15px;
  }
  @media (max-width: 420px) {
    .s09-ticket__stamp { width: 46px; height: 46px; font-size: 13px; }
  }

  .s09-ticket__body { min-width: 0; }
  .s09-ticket__floor {
    font-family: var(--font-en);
    font-weight: 800;
    font-size: 12px;
    letter-spacing: .1em;
    color: var(--color-orange);
    margin: 0 0 2px;
  }
  .s09-ticket__size {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 17px;
    margin: 0;
    color: var(--color-ink);
  }
  .s09-ticket__size small { font-family: var(--font-body); font-weight: 500; font-size: 12px; opacity: .75; }
  .s09-ticket__dir {
    font-family: var(--font-body);
    font-size: 13px;
    margin: 2px 0 0;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .s09-sun { width: 16px; height: 16px; flex: none; }

  .s09-ticket__price { text-align: right; padding-right: var(--sp-1); align-self: end; }
  .s09-ticket__price .price-pop { font-size: 20px; padding: 10px 14px 6px; }

  /* 写真:カード右上に貼りついたポラロイド(角度をつけて動きを出す)
     価格POPは下端寄せにしてあるので、ポラロイドとは重ならない */
  .s09-photo-pin {
    position: absolute;
    top: -20px;
    right: -12px;
    width: 106px;
    z-index: 3;
  }
  .s09-photo-pin .photo-frame { padding: 6px 6px 22px; width: 100%; }
  .s09-photo-pin .photo-frame__caption {
    font-size: 10px;
    line-height: 1.6;
    left: 4px;
    right: 4px;
    bottom: 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .s09-photo-pin--sub {
    position: absolute;
    top: -8px;
    right: -24px;
    width: 64px;
    z-index: 2;
    opacity: .96;
  }
  .s09-photo-pin--sub .photo-frame { padding: 5px 5px 18px; }
  @media (max-width: 640px) {
    .s09-photo-pin { width: 84px; top: -14px; right: -10px; }
    .s09-photo-pin--sub { width: 54px; right: -22px; }
  }

  /* 302・304 写真準備中の紙片 */
  .s09-pending {
    position: absolute;
    top: -16px;
    right: -10px;
    width: 108px;
    background: var(--color-cream);
    border: 2px dashed var(--color-ink-grid);
    border-radius: var(--r-sm);
    padding: 8px;
    transform: rotate(4deg);
    z-index: 3;
    box-shadow: var(--shadow-sticker);
  }
  .s09-pending p {
    margin: 0;
    font-family: var(--font-hand);
    font-size: 11px;
    line-height: 1.5;
    color: var(--color-ink);
  }
  @media (max-width: 640px) {
    .s09-pending { width: 92px; top: -10px; right: -8px; }
  }

  .s09-badge--fudan {
    position: absolute;
    bottom: -12px;
    left: 20px;
    z-index: 3;
  }

  .s09-cta-row {
    text-align: center;
    margin-top: var(--sp-5);
  }

  .s09-arrow-hand {
    position: absolute;
    top: -30px;
    left: -18px;
    width: 60px;
    transform: rotate(140deg);
    opacity: .8;
    z-index: 1;
  }

/* ================= section 10 ================= */
/* ==== s10 立地・商店街マップ ==== */
  .s10-section {
    background: var(--color-teal-soft);
    position: relative;
  }
  .s10-corner-dots {
    position: absolute;
    bottom: 0; left: 0;
    width: 220px; height: 220px;
    opacity: .5;
    pointer-events: none;
    z-index: 0;
  }

  .s10-layout {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: .95fr 1.05fr;
    gap: var(--sp-5);
    align-items: start;
    margin-bottom: var(--sp-5);
  }
  @media (max-width: 880px) {
    .s10-layout { grid-template-columns: 1fr; gap: var(--sp-4); }
  }

  .s10-photo-col { position: relative; width: min(420px, 100%); margin-inline: auto; }
  .s10-photo-col .photo-frame { width: 100%; }

  .s10-here-stamp {
    position: absolute;
    top: -20px;
    left: -18px;
    z-index: 3;
  }
  @media (max-width: 500px) {
    .s10-here-stamp { top: -14px; left: -10px; }
  }
  .s10-here-copy {
    font-family: var(--font-hand);
    font-size: 15px;
    text-align: center;
    margin-top: var(--sp-2);
    color: var(--color-ink);
  }

  .s10-route__list {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .s10-route__list::before {
    /* 点線ルート */
    content: "";
    position: absolute;
    top: 10px;
    bottom: 10px;
    left: 27px;
    border-left: 3px dashed var(--color-ink);
    opacity: .35;
  }
  .s10-route__item {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 10px 0;
  }
  .s10-route__dot {
    position: relative;
    z-index: 1;
    width: 56px;
    height: 56px;
    flex: none;
    font-size: 13px;
  }
  .s10-route__label {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 16px;
    color: var(--color-ink);
    display: flex;
    align-items: baseline;
    gap: var(--sp-1);
    flex-wrap: wrap;
  }
  .s10-route__hand {
    font-family: var(--font-hand);
    font-size: 13px;
    color: var(--color-orange);
  }

  .s10-body {
    max-width: 68ch;
    margin: 0 auto var(--sp-5);
    text-align: center;
    font-size: 16px;
  }

  .s10-train {
    background: var(--color-paper);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-card);
    padding: var(--sp-3) var(--sp-4);
    max-width: 640px;
    margin-inline: auto;
    position: relative;
  }
  .s10-train__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 16px;
    margin: 0 0 var(--sp-2);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .s10-train__list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
    font-size: 15px;
    display: grid;
    gap: 8px;
  }
  .s10-train__list li::before {
    content: "🚃";
    margin-right: 6px;
  }

  .s10-arrow {
    position: absolute;
    top: -34px;
    right: 10%;
    width: 90px;
    transform: scaleX(-1) rotate(-8deg);
    opacity: .85;
  }

/* ================= section 11 ================= */
/* ==== s11 料金まとめ ==== */
  .s11-section {
    background: var(--color-cream);
    position: relative;
  }

  .s11-marquee-zone { margin-bottom: var(--sp-5); }
  .s11-marquee-zone .section-diagonal { padding-block: 16px; }
  .s11-marquee-zone .marquee-band__track { font-size: 15px; }

  .s11-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-4);
    align-items: stretch;
    margin-bottom: var(--sp-4);
  }
  @media (max-width: 820px) {
    .s11-cols { grid-template-columns: 1fr; }
  }

  .s11-card {
    background: var(--color-paper);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-card);
    padding: var(--sp-4);
    position: relative;
  }
  .s11-card__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 18px;
    margin: 0 0 var(--sp-2);
  }

  .s11-price-hero { text-align: center; margin-bottom: var(--sp-2); }
  .s11-price-hero .price-pop { font-size: clamp(30px, 4vw, 40px); }
  .s11-price-hero__label { font-family: var(--font-body); font-size: 13px; margin-top: 6px; }

  .s11-list { list-style: none; margin: var(--sp-2) 0 0; padding: 0; display: grid; gap: 8px; }
  .s11-list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-body);
    font-size: 15px;
    border-bottom: 1px dashed var(--color-ink-grid);
    padding-bottom: 6px;
  }
  .s11-list strong { font-family: var(--font-heading); font-weight: 800; color: var(--color-orange); }

  .s11-micro {
    font-family: var(--font-body);
    font-size: 13px;
    opacity: .85;
    margin-top: var(--sp-2);
  }

  .s11-monthly-figure { text-align: center; margin: var(--sp-2) 0; }
  .s11-monthly-figure .card__number { font-family: var(--font-display); color: var(--color-orange); font-size: clamp(22px, 3.4vw, 30px); display: block; }
  .s11-plus { font-family: var(--font-heading); font-weight: 800; opacity: .6; }

  .s11-circle-wrap { position: relative; display: inline-block; padding: 2px 10px; }
  .s11-circle-wrap svg { position: absolute; inset: -8px -6px; width: calc(100% + 16px); height: calc(100% + 22px); z-index: -1; }

  .s11-hand-note {
    font-family: var(--font-hand);
    font-size: 14px;
    color: var(--color-orange);
    text-align: center;
    margin-top: var(--sp-1);
  }

  .s11-badge-fudan {
    position: absolute;
    top: -16px;
    right: 14px;
    z-index: 2;
  }

  .s11-compare {
    background: var(--color-orange-soft);
    border-radius: var(--r-md);
    padding: var(--sp-4);
    max-width: 760px;
    margin: 0 auto var(--sp-4);
    position: relative;
  }
  .s11-compare__body {
    font-size: 16px;
    margin: 0 0 var(--sp-3);
  }
  .s11-compare__memo {
    font-family: var(--font-body);
    font-size: 13px;
    opacity: .85;
    border-top: 2px dashed var(--color-ink-grid);
    padding-top: var(--sp-2);
    margin: 0;
  }

  .s11-arrow-deco {
    position: absolute;
    top: -20px;
    left: 24px;
    width: 70px;
    opacity: .8;
  }

  .s11-cta-row { text-align: center; }

/* ================= section 12 ================= */
/* ==== s12 入居まで4ステップ(すごろく/スタンプラリー) ==== */
  .s12-section {
    background: var(--color-orange-soft);
    position: relative;
  }
  .s12-confetti {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .s12-heading .section-heading__title { position: relative; display: inline-block; }

  .s12-board {
    position: relative;
    z-index: 1;
    max-width: 780px;
    margin: var(--sp-5) auto 0;
  }

  /* 手描き風の点線ルート(すごろく道)。SVGを背景に敷き、カードは前面に配置 */
  .s12-route {
    position: absolute;
    left: 27px;
    top: 10px;
    bottom: 10px;
    width: 3px;
    z-index: 0;
  }
  .s12-route svg { width: 100%; height: 100%; }

  .s12-steps {
    list-style: none;
    margin: 0;
    padding-left: 68px;
    position: relative;
    z-index: 1;
  }
  .s12-step {
    position: relative;
    padding-bottom: var(--sp-5);
  }
  .s12-step:last-child { padding-bottom: 0; }
  .s12-step:nth-child(even) .s12-step__card { margin-left: var(--sp-3); }

  .s12-stamp {
    position: absolute;
    left: -68px;
    top: -4px;
    background: var(--color-orange);
    color: var(--color-cream);
    border-color: var(--color-paper);
    font-size: 20px;
  }
  .s12-step:nth-child(1) .s12-stamp { transform: rotate(-6deg); }
  .s12-step:nth-child(2) .s12-stamp { transform: rotate(5deg); }
  .s12-step:nth-child(3) .s12-stamp { transform: rotate(-4deg); }
  .s12-step:nth-child(4) .s12-stamp { transform: rotate(6deg); }

  .s12-step__card {
    background: var(--color-paper);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-card);
    padding: var(--sp-3) var(--sp-3);
    position: relative;
  }
  .s12-step:nth-child(odd) .s12-step__card { transform: rotate(-1deg); }
  .s12-step:nth-child(even) .s12-step__card { transform: rotate(1deg); }

  .s12-step__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(18px, 2.4vw, 22px);
    margin: 0 0 6px;
    color: var(--color-ink);
  }
  .s12-step__text {
    font-family: var(--font-body);
    font-size: 15.5px;
    line-height: 1.85;
    margin: 0;
    color: var(--color-ink);
  }

  .s12-annot {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-1);
    margin-top: var(--sp-2);
  }
  .s12-annot svg { flex: none; margin-top: -2px; }
  .s12-annot span {
    font-family: var(--font-hand);
    font-size: 14px;
    color: var(--color-orange);
  }

  .s12-bubble {
    position: relative;
    width: min(280px, 100%);
    margin-top: var(--sp-2);
  }
  .s12-bubble svg { width: 100%; height: auto; display: block; }
  .s12-bubble__text {
    position: absolute;
    inset: 10px 18px 32px 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--font-hand);
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--color-ink);
    overflow: hidden;
  }

  .s12-step__badge {
    position: absolute;
    top: -16px;
    right: -10px;
    z-index: 2;
  }

  .s12-closing {
    position: relative;
    z-index: 1;
    text-align: center;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(18px, 2.8vw, 24px);
    color: var(--color-ink);
    margin-top: var(--sp-6);
  }

  .s12-cta-row {
    position: relative;
    z-index: 1;
    text-align: center;
    margin-top: var(--sp-3);
  }

  @media (max-width: 560px) {
    .s12-steps { padding-left: 56px; }
    .s12-route { left: 23px; }
    .s12-stamp { left: -56px; width: 46px; height: 46px; font-size: 16px; }
    .s12-step:nth-child(even) .s12-step__card { margin-left: 0; }
    .s12-step__badge { right: -4px; }
  }

/* ================= section 13 ================= */
/* ==== s13 FAQ ==== */
  .s13-section {
    background: var(--color-cream);
    position: relative;
  }

  .s13-divider {
    display: block;
    margin: 0 auto var(--sp-4);
    width: min(360px, 70%);
    opacity: .55;
  }

  .s13-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-3) var(--sp-4);
    align-items: start;
  }
  @media (max-width: 780px) {
    .s13-grid { grid-template-columns: 1fr; }
  }
  .s13-item--span2 { grid-column: 1 / -1; }

  .s13-item {
    background: var(--color-paper);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-card);
    padding: 0;
    overflow: hidden;
  }
  .s13-item:nth-child(4n+1) { transform: rotate(-1deg); }
  .s13-item:nth-child(4n+2) { transform: rotate(1deg); }
  .s13-item:nth-child(4n+3) { transform: rotate(-1.4deg); }
  .s13-item:nth-child(4n+4) { transform: rotate(1.4deg); }

  .s13-item summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    grid-template-columns: 44px 1fr 28px;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-2) var(--sp-3);
  }
  .s13-item summary::-webkit-details-marker { display: none; }

  .s13-item__num {
    font-family: var(--font-display);
    font-size: 18px;
    color: var(--color-cream);
    background: var(--color-teal);
    border-radius: var(--r-full);
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }
  .s13-item__q {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 15.5px;
    line-height: 1.5;
    color: var(--color-ink);
  }
  .s13-item__icon {
    width: 28px;
    height: 28px;
    flex: none;
    transition: transform .3s var(--ease-out);
  }
  .s13-item[open] .s13-item__icon { transform: rotate(45deg); }

  .s13-item__body {
    padding: 0 var(--sp-3) var(--sp-3) calc(44px + var(--sp-2) + var(--sp-3));
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.85;
    color: var(--color-ink);
  }
  @media (max-width: 480px) {
    .s13-item__body { padding-left: var(--sp-3); }
  }

  .s13-hand-circle { position: relative; display: inline-block; padding: 2px 8px; }
  .s13-hand-circle svg { position: absolute; inset: -8px -4px; width: calc(100% + 16px); height: calc(100% + 20px); z-index: -1; }

/* ================= section 14 ================= */
/* ==== s14 最終CTA+フッター ==== */
  .s14-section {
    background: var(--color-ink);
    color: var(--color-cream);
    position: relative;
  }
  .s14-confetti {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .s14-layout {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: .85fr 1.15fr;
    gap: var(--sp-5);
    align-items: center;
  }
  @media (max-width: 860px) {
    .s14-layout { grid-template-columns: 1fr; }
  }

  /* 空白ポラロイド枠(案3): 写真の代わりに余白のまま */
  .s14-blank-polaroid {
    display: block;
    width: min(320px, 84%);
    margin: 0 auto;
    background: var(--color-paper);
    padding: 10px 10px 44px;
    box-shadow: var(--shadow-polaroid);
    border-radius: 2px;
    transform: rotate(-3deg);
    position: relative;
  }
  .s14-blank-polaroid__area {
    aspect-ratio: 16 / 10;
    background:
      repeating-linear-gradient(135deg, rgba(27,27,58,.08) 0 10px, transparent 10px 20px),
      var(--color-cream);
    border-radius: 1px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .s14-blank-polaroid__hint {
    font-family: var(--font-hand);
    font-size: 13px;
    color: var(--color-ink);
    opacity: .55;
  }
  .s14-blank-polaroid__caption {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    text-align: center;
    font-family: var(--font-hand);
    font-size: 14px;
    color: var(--color-ink);
  }
  .s14-tape {
    position: absolute;
    width: 70px;
    height: 24px;
    top: -12px;
    left: 50%;
    transform: translateX(-50%) rotate(-6deg);
    opacity: .85;
    background: var(--color-teal);
  }

  .s14-copy { text-align: left; }
  @media (max-width: 860px) { .s14-copy { text-align: center; } }

  .s14-title {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(30px, 4.6vw, 48px);
    line-height: 1.35;
    color: var(--color-cream);
    margin: 0 0 var(--sp-3);
  }
  .s14-lead {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.9;
    color: var(--color-cream);
    opacity: .9;
    margin: 0 0 var(--sp-4);
    max-width: 46ch;
  }
  @media (max-width: 860px) { .s14-lead { margin-inline: auto; } }

  .s14-cta-block { }
  .s14-cta-block .btn--cta { font-size: 18px; padding: var(--sp-3) var(--sp-5); }
  .s14-cta-arrow { display: block; margin: 0 0 -6px 4px; transform: rotate(6deg); }
  @media (max-width: 860px) { .s14-cta-arrow { margin-inline: auto; } }
  .s14-cta-micro {
    font-family: var(--font-hand);
    font-size: 14px;
    color: var(--color-yellow);
    margin-top: var(--sp-2);
  }

  /* ---- フッター ---- */
  .s14-footer {
    position: relative;
    z-index: 1;
    background: var(--color-ink);
    border-top: 2px dashed rgba(255,246,233,.25);
    padding-block: var(--sp-4);
    margin-top: var(--sp-6);
  }
  .s14-footer__grid {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--sp-4);
    align-items: center;
  }
  @media (max-width: 780px) {
    .s14-footer__grid {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
    }
  }

  .s14-logo-card {
    background: var(--color-cream);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-card);
    padding: var(--sp-2) var(--sp-3);
    display: inline-flex;
    align-items: center;
  }
  .s14-logo-card img { height: 34px; width: auto; }

  .s14-footer__info {
    font-family: var(--font-body);
    font-size: 13.5px;
    line-height: 1.8;
    color: var(--color-cream);
    opacity: .85;
  }
  .s14-footer__info strong {
    display: block;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 15px;
    opacity: 1;
    margin-bottom: 2px;
  }
  .s14-footer__info a { color: var(--color-yellow); text-decoration: underline; }

  .s14-footer__nav {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-3);
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 13.5px;
  }
  .s14-footer__nav a { color: var(--color-cream); text-decoration: none; opacity: .85; }
  .s14-footer__nav a:hover { opacity: 1; text-decoration: underline; }

  .s14-footer__bottom {
    margin-top: var(--sp-3);
    padding-top: var(--sp-2);
    border-top: 1px solid rgba(255,246,233,.15);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-1);
  }
  @media (max-width: 780px) {
    .s14-footer__bottom { justify-content: center; text-align: center; }
  }
  .s14-copyright {
    font-family: var(--font-body);
    font-size: 12.5px;
    color: var(--color-cream);
    opacity: .6;
  }
  .s14-lastword {
    font-family: var(--font-hand);
    font-size: 14px;
    color: var(--color-yellow);
  }

/* ================= 結合時の追加スタイル(整合性フィックス+SP用UI) ================= */
html { scroll-behavior: smooth; scroll-padding-top: 76px; }
body { margin: 0; }

/* tokens.css に未定義だった回転ユーティリティ(s09で使用) */
.rotate-n3 { transform: rotate(-3deg) !important; }
.rotate-3  { transform: rotate(3deg)  !important; }

/* ---- SP全画面メニュー(cream+紙吹雪) ---- */
.sp-menu {
  position: fixed;
  inset: 0;
  z-index: 40;
  background: var(--color-cream);
  display: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--sp-3);
  padding: 90px var(--sp-3) var(--sp-4);
  text-align: center;
}
.sp-menu.is-open { display: flex; }
.sp-menu__links { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-3); }
.sp-menu__links a {
  font-family: var(--font-heading);
  font-weight: 800;
  font-size: 22px;
  color: var(--color-ink);
  text-decoration: none;
}
.sp-menu__links a:hover { color: var(--color-orange); }
.sp-menu__confetti { position: absolute; inset: 0; pointer-events: none; }
.sp-menu > * { position: relative; }
body.sp-menu-open { overflow: hidden; }

/* ---- モバイル用スティッキー底部CTAバー ---- */
.sp-cta-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 60;
  display: none;
  padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px));
  background: rgba(255, 246, 233, .96);
  border-top: 3px solid var(--color-ink);
  transform: translateY(110%);
  transition: transform .3s var(--ease-out);
}
.sp-cta-bar.is-shown { transform: translateY(0); }
.sp-cta-bar .btn--cta {
  width: 100%;
  font-size: 15px;
  padding: 12px var(--sp-3);
}
@media (max-width: 800px) {
  .sp-cta-bar { display: block; }
}
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .sp-cta-bar { transition: none; }
}
/* CLS対策で全imgにwidth/height属性を付けたことによる副作用の打ち消し。
   このLPのCSSは高さを指定せず intrinsic 比率に任せる作りなので、
   height:auto を入れないと height属性の値(768px等)がそのまま効いて崩れる。
   詳細度0,0,1なのでクラス指定で高さを持つ画像には影響しない。 */
img { height: auto; }
